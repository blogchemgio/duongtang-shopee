---
import image1 from '../assets/1.webp';
import image2 from '../assets/2.png';
import image3 from '../assets/3.png';
import image4 from '../assets/4.webp';
import image5 from '../assets/5.png';

const images = [
  { src: image1.src, width: image1.width, height: image1.height, alt: 'Ảnh hero 1' },
  { src: image2.src, width: image2.width, height: image2.height, alt: 'Ảnh hero 2' },
  { src: image3.src, width: image3.width, height: image3.height, alt: 'Ảnh hero 3' },
  { src: image4.src, width: image4.width, height: image4.height, alt: 'Ảnh hero 4' },
  { src: image5.src, width: image5.width, height: image5.height, alt: 'Ảnh hero 5' },
];
---

<section 
  class="hero group relative mb-6 overflow-hidden rounded-[24px] border transition-all duration-500
         bg-slate-50 border-slate-200 p-4 sm:p-6 md:p-8 lg:p-10
         dark:bg-slate-950 dark:border-slate-800"
>
  <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-orange-500/5 blur-[70px] z-0"></div>

  <div class="relative z-10 max-w-5xl mx-auto">
    <div class="overflow-hidden rounded-[20px] ring-1 ring-slate-200/80 dark:ring-white/10 bg-white/60 dark:bg-white/5">
      <img
        id="hero-random-image"
        src={images[0].src}
        alt={images[0].alt}
        width={images[0].width}
        height={images[0].height}
        loading="eager"
        decoding="async"
        class="w-full h-[220px] sm:h-[280px] md:h-[340px] lg:h-[380px] object-cover"
      />
    </div>
  </div>
</section>

<script type="application/json" id="hero-images" set:html={JSON.stringify(images)}></script>

<script>
  const jsonEl = document.getElementById('hero-images');
  const imgEl = document.getElementById('hero-random-image');
  if (jsonEl instanceof HTMLScriptElement && imgEl instanceof HTMLImageElement) {
    const list = JSON.parse(jsonEl.textContent || '[]');
    if (Array.isArray(list) && list.length > 0) {
      const pick = list[Math.floor(Math.random() * list.length)];
      if (pick && typeof pick.src === 'string') {
        imgEl.src = pick.src;
        if (typeof pick.alt === 'string') imgEl.alt = pick.alt;
        if (typeof pick.width === 'number') imgEl.width = pick.width;
        if (typeof pick.height === 'number') imgEl.height = pick.height;
      }
    }
  }
</script>
