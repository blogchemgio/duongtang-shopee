---
const categories = [
  { name: "Thời Trang Nam", affLink: "https://shorten.asia/X4mqK3As" },
  { name: "Phụ Kiện Điện Thoại", affLink: "https://shorten.asia/tfrPBrqR" },
  { name: "Thiết Bị Điện Tử", affLink: "https://shorten.asia/JcAAWTmd" },
  { name: "Máy Tính & Laptop", affLink: "https://shorten.asia/F7ss9yPt" },
  { name: "Máy Ảnh & Quay Phim", affLink: "https://shorten.asia/bZUQHjY8" },
  { name: "Đồng Hồ", affLink: "https://shorten.asia/udrmQNzJ" },
  { name: "Giày Dép Nam", affLink: "https://shorten.asia/5fgvuSBN" },
  { name: "Thiết Bị Gia Dụng", affLink: "https://shorten.asia/XCaPG72W" },
  { name: "Thể Thao & Du Lịch", affLink: "https://shorten.asia/9YXxb1Fc" },
  { name: "Xe Máy & Xe Đạp", affLink: "https://shorten.asia/7EkAXQNN" },
  { name: "Balo, Túi & Ví", affLink: "https://shorten.asia/GYgQ5VbF" },
  { name: "Đồ Chơi", affLink: "https://shorten.asia/Kk226puw" }
];

// Chia đôi mảng danh mục
const row1 = categories.slice(0, 6);
const row2 = categories.slice(6);
---

<section 
  class="hero relative mb-8 overflow-hidden rounded-[20px] border
         bg-[#efe7d2] border-black/5 p-4 sm:p-6
         dark:bg-[#121212] dark:border-white/5 shadow-sm"
>
  <!-- Vầng sáng decor -->
  <div class="absolute -right-12 -top-12 h-32 w-32 rounded-full bg-[#EB6658]/10 blur-[40px] pointer-events-none"></div>

  <div class="relative z-10 w-full flex flex-col gap-4">
    <div class="flex items-center justify-between px-1">
      <h3 class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-[0.2em]">
        Danh mục mua sắm
      </h3>
      <span class="text-[9px] font-bold text-[#EB6658]/70 uppercase animate-pulse">Lướt ngang từng hàng →</span>
    </div>

    <!-- Hàng 1: Vuốt độc lập -->
    <div class="no-scrollbar overflow-x-auto touch-pan-x snap-x pb-1">
      <div class="flex flex-nowrap gap-2 w-max px-1">
        {row1.map((cat) => (
          <a 
            href={cat.affLink} 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex-none inline-flex items-center justify-center px-5 py-2.5 rounded-full border border-white/40 bg-white/40 backdrop-blur-md transition-all 
                   snap-start whitespace-nowrap active:scale-95 hover:bg-white/60
                   dark:border-white/10 dark:bg-white/5 dark:hover:bg-white/10"
          >
            <span class="text-[12px] font-bold text-gray-700 dark:text-gray-200 tracking-wide leading-none">
              {cat.name}
            </span>
          </a>
        ))}
        <div class="w-8 flex-none"></div>
      </div>
    </div>

    <!-- Hàng 2: Vuốt độc lập -->
    <div class="no-scrollbar overflow-x-auto touch-pan-x snap-x pb-1">
      <div class="flex flex-nowrap gap-2 w-max px-1">
        {row2.map((cat) => (
          <a 
            href={cat.affLink} 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex-none inline-flex items-center justify-center px-5 py-2.5 rounded-full border border-white/40 bg-white/40 backdrop-blur-md transition-all 
                   snap-start whitespace-nowrap active:scale-95 hover:bg-white/60
                   dark:border-white/10 dark:bg-white/5 dark:hover:bg-white/10"
          >
            <span class="text-[12px] font-bold text-gray-700 dark:text-gray-200 tracking-wide leading-none">
              {cat.name}
            </span>
          </a>
        ))}
        <div class="w-8 flex-none"></div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ẩn thanh cuộn triệt để */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
</style>