---
// Hero Component Astro - Ultra Balanced & Connected
---

<section 
  class="hero group relative mb-6 overflow-hidden rounded-[24px] border transition-all duration-500
         bg-slate-50 border-slate-200 p-6 md:p-10 lg:p-12
         dark:bg-slate-950 dark:border-slate-800"
>
  <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-orange-500/5 blur-[70px] z-0"></div>

  <div class="relative z-10 max-w-5xl mx-auto flex flex-col lg:flex-row lg:items-center gap-10 lg:gap-16">
    
    <div class="flex flex-col gap-5 flex-1">
      <div class="hero__mobile-rotator" aria-live="polite">
        <p
          class="hero__mobile-line text-[22px] sm:text-[24px] font-black tracking-tight text-slate-900 dark:text-white"
          data-mobile-rotator-line
        >
          <span data-mobile-rotator-output></span><span class="hero__caret" aria-hidden="true"></span>
        </p>
      </div>

      <div class="hero__desktop-lines">
        <div>
          <h1 class="hero__title font-black tracking-tight leading-tight select-none">
            <span class="hero__title-main text-[16px] sm:text-[20px] md:text-xl lg:text-2xl uppercase text-slate-950 dark:text-white">
             1 Học Lập Trình
            </span>
            <span class="hero__title-highlight text-[16px] sm:text-[20px] md:text-xl lg:text-2xl italic ml-1.5 uppercase text-[#ff7a18]">
              Astro Thực Chiến
            </span>
          </h1>
        </div>

        <div class="flex flex-col gap-4">
          <p
            class="hero__typewriter text-[11px] md:text-[13px] font-semibold tracking-wide italic text-slate-500 dark:text-slate-400"
            data-desktop-typewriter-line
            data-typewriter-text="Hành trình vạn dặm từ những dòng code đầu tiên"
            aria-label="Hành trình vạn dặm từ những dòng code đầu tiên"
          >
            <span data-desktop-typewriter-output></span><span class="hero__caret" aria-hidden="true"></span>
          </p>
          
          <div class="hero__tagline flex items-center gap-3">
            <span class="h-5 w-[3px] bg-[#ff7a18] rounded-full shrink-0"></span>
            <p class="text-[13px] md:text-[15px] font-medium leading-relaxed flex-1 text-slate-700 dark:text-slate-300">
              Trang bị <span class="text-slate-950 dark:text-white font-bold">"Vũ trụ công nghệ"</span> để bứt phá từ F0.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="hidden lg:block w-[1px] h-24 bg-gradient-to-b from-transparent via-slate-200 dark:via-slate-800 to-transparent"></div>

    <div class="flex flex-col gap-4 w-full lg:w-[320px] shrink-0">
      <p class="text-[9px] md:text-[10px] font-black uppercase tracking-[0.15em] 
                text-slate-950 dark:text-white dark:drop-shadow-[0_0_6px_rgba(255,255,255,0.6)]">
        ⚠️ Cài đặt ngay để Start
      </p>

      <div class="grid grid-cols-2 gap-2">
        <a href="https://nodejs.org/" target="_blank" rel="noopener noreferrer" 
           class="group/btn flex items-center gap-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-white/5 bg-white dark:bg-white/5 transition-all duration-300 hover:border-[#339933]/50 hover:shadow-lg hover:shadow-[#339933]/10 hover:-translate-y-0.5">
          <svg class="h-4 w-4 fill-[#339933]" viewBox="0 0 24 24"><path d="M12 2a1 1 0 0 1 .533.153l7 4.14A1 1 0 0 1 20 7.153v8.694a1 1 0 0 1-.533.86L12.467 21.8a1 1 0 0 1-.934 0l-7-4.14A1 1 0 0 1 4 16.847V7.153a1 1 0 0 1 .467-.847L11.467 2.153A1 1 0 0 1 12 2zm0 2.153L6 7.63v8.74l6 3.477 6-3.477V7.63L12 4.153z"/></svg>
          <span class="text-[11px] font-bold text-slate-600 dark:text-slate-400 group-hover/btn:text-[#339933]">Node.js</span>
        </a>

        <a href="https://code.visualstudio.com/" target="_blank" rel="noopener noreferrer"
           class="group/btn flex items-center gap-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-white/5 bg-white dark:bg-white/5 transition-all duration-300 hover:border-[#007ACC]/50 hover:shadow-lg hover:shadow-[#007ACC]/10 hover:-translate-y-0.5">
          <svg class="h-4 w-4 fill-[#007ACC]" viewBox="0 0 24 24"><path d="M22.95 5.5l-4.2-3.8c-.3-.2-.6-.2-.9 0l-10.4 6.7-4.1-3.c-.2-.2-.5-.2-.7 0L.3 7c-.2.2-.2.5 0 .7l3.8 3-3.8 3c-.2.2-.2.5 0 .7l2.2 1.6c.2.2.5.2.7 0l4.1-3 10.4 6.7c.3.2.6.2.9 0l4.2-3.8c.2-.2.2-.5 0-.7L17.5 12l5.4-4.8c.2-.2.2-.5 0-.7zm-11.8 11L6.7 12.5l4.4-4.1 3.2 2-7.6 1.7z"/></svg>
          <span class="text-[11px] font-bold text-slate-600 dark:text-slate-400 group-hover/btn:text-[#007ACC]">VS Code</span>
        </a>

        <a href="https://github.com/" target="_blank" rel="noopener noreferrer"
           class="group/btn flex items-center gap-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-white/5 bg-white dark:bg-white/5 transition-all duration-300 hover:border-slate-400 dark:hover:border-slate-500 hover:shadow-lg hover:-translate-y-0.5">
          <svg class="h-4 w-4 fill-slate-700 dark:fill-slate-300" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          <span class="text-[11px] font-bold text-slate-600 dark:text-slate-400 group-hover/btn:text-slate-900 dark:group-hover/btn:text-white">GitHub</span>
        </a>

        <a href="https://cloudflare.com/" target="_blank" rel="noopener noreferrer"
           class="group/btn flex items-center gap-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-white/5 bg-white dark:bg-white/5 transition-all duration-300 hover:border-[#F38020]/50 hover:shadow-lg hover:shadow-[#F38020]/10 hover:-translate-y-0.5">
          <svg class="h-4 w-4 fill-[#F38020]" viewBox="0 0 24 24"><path d="M22.05 12.983c0-2.474-2.023-4.483-4.517-4.483-.15 0-.297.007-.442.021C15.892 5.512 13.167 3.5 10 3.5c-3.666 0-6.667 2.883-7.017 6.517C1.292 10.683 0 12.35 0 14.333 0 16.633 1.867 18.5 4.167 18.5h15.833c2.208 0 4-1.792 4-4s-1.792-4-4-4c-.117 0-.233.008-.35.017.15-.45.233-.917.233-1.408v-.126z"/></svg>
          <span class="text-[11px] font-bold text-slate-600 dark:text-slate-400 group-hover/btn:text-[#F38020]">Cloudflare</span>
        </a>

        <a href="https://vercel.com/" target="_blank" rel="noopener noreferrer"
           class="group/cta col-span-2 mt-1 w-full flex items-center justify-center gap-2 bg-slate-900 dark:bg-slate-100 text-white dark:text-black py-2.5 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all duration-300 hover:bg-[#ff7a18] dark:hover:bg-[#ff7a18] hover:text-white hover:shadow-xl hover:shadow-orange-500/20 active:scale-[0.98]">
            Triển khai dự án
            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover/cta:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
              <path d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero__mobile-rotator {
    display: block;
    min-height: 2.2rem;
  }

  .hero__mobile-line {
    margin: 0;
    min-height: 1.3em;
    opacity: 0;
    transform: translateX(12px);
    transition: opacity 280ms ease, transform 320ms ease, filter 320ms ease;
    filter: blur(3px);
  }

  .hero__mobile-line.is-visible {
    opacity: 1;
    transform: translateX(0);
    filter: blur(0);
  }

  .hero__mobile-line.is-glow {
    text-shadow: 0 0 12px rgba(255, 122, 24, 0.2);
  }

  .hero__mobile-main {
    color: #020617;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .hero__mobile-highlight {
    color: #ea580c;
    margin-left: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-style: italic;
  }

  :global(.is-dark) .hero__mobile-main {
    color: #f8fafc;
  }

  :global(.is-dark) .hero__mobile-highlight {
    color: #fb923c;
  }

  .hero__desktop-lines {
    display: none;
    gap: 1rem;
  }

  .hero__title {
    opacity: 0;
    transform: translate3d(34px, 0, 0);
    animation: hero-slide-in 900ms cubic-bezier(0.2, 0.8, 0.2, 1) 120ms forwards,
      hero-soft-loop 6s ease-in-out 1.2s infinite;
  }

  .hero__title-main,
  .hero__title-highlight {
    display: inline-block;
  }

  .hero__typewriter {
    min-height: 1.4em;
    opacity: 0;
    animation: hero-fade-up 500ms ease 540ms forwards;
  }

  .hero__caret {
    display: inline-block;
    width: 1px;
    height: 1.05em;
    margin-left: 2px;
    background: currentColor;
    transform: translateY(2px);
    animation: hero-caret-blink 1s step-end infinite;
  }

  .hero__tagline {
    opacity: 0;
    transform: translateY(10px);
    animation: hero-glow-rise 800ms cubic-bezier(0.22, 1, 0.36, 1) 950ms forwards,
      hero-tagline-loop 6.2s ease-in-out 1.4s infinite;
  }

  @keyframes hero-slide-in {
    from {
      opacity: 0;
      transform: translate3d(34px, 0, 0);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
      filter: blur(0);
    }
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-glow-rise {
    0% {
      opacity: 0;
      transform: translateY(10px);
      text-shadow: none;
    }
    75% {
      opacity: 1;
      transform: translateY(0);
      text-shadow: 0 0 22px rgba(255, 122, 24, 0.2);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      text-shadow: 0 0 10px rgba(255, 122, 24, 0.14);
    }
  }

  @keyframes hero-caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @keyframes hero-soft-loop {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
      opacity: 1;
    }
    50% {
      transform: translate3d(0, -1px, 0);
      opacity: 0.92;
    }
  }

  @keyframes hero-tagline-loop {
    0%,
    100% {
      text-shadow: 0 0 8px rgba(255, 122, 24, 0.12);
    }
    50% {
      text-shadow: 0 0 16px rgba(255, 122, 24, 0.2);
    }
  }

  @media (min-width: 1024px) {
    .hero__mobile-rotator {
      display: none;
    }

    .hero__desktop-lines {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__mobile-line,
    .hero__title,
    .hero__typewriter,
    .hero__tagline {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }

    .hero__caret {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero__title {
      line-height: 1.35;
    }
  }
</style>

<script>
  const hero = document.querySelector('.hero');
  if (hero) {
    const wait = (ms) => new Promise((resolve) => window.setTimeout(resolve, ms));
    const desktopTypeSpeed = 102;
    const desktopHoldAfterType = 2300;
    const desktopGapBeforeRestart = 850;
    const mobileTypeSpeed = 98;
    const mobileFadeInDelay = 260;
    const mobileHoldAfterType = 1600;
    const mobileHoldStatic = 2200;
    const mobileFadeOutGap = 420;

    const typeText = async (target, text, speedMs) => {
      target.textContent = '';
      for (let i = 1; i <= text.length; i += 1) {
        target.textContent = text.slice(0, i);
        await wait(speedMs);
      }
    };

    const desktopLine = hero.querySelector('[data-desktop-typewriter-line]');
    const desktopOutput = hero.querySelector('[data-desktop-typewriter-output]');
    const desktopText =
      desktopLine instanceof HTMLElement ? desktopLine.getAttribute('data-typewriter-text') || '' : '';
    if (desktopLine instanceof HTMLElement && desktopOutput instanceof HTMLElement && desktopText) {
      const runDesktopLoop = async () => {
        while (true) {
          await typeText(desktopOutput, desktopText, desktopTypeSpeed);
          await wait(desktopHoldAfterType);
          desktopOutput.textContent = '';
          await wait(desktopGapBeforeRestart);
        }
      };
      runDesktopLoop();
    }

    const mobileLine = hero.querySelector('[data-mobile-rotator-line]');
    const mobileOutput = hero.querySelector('[data-mobile-rotator-output]');
    if (mobileLine instanceof HTMLElement && mobileOutput instanceof HTMLElement) {
      const steps = [
        {
          text: 'HỌC LẬP TRÌNH ASTRO THỰC CHIẾN',
          kind: 'slide',
          // ĐÃ SỬA: Thêm &nbsp; vào giữa 2 thẻ span để tránh dính chữ
          html: '<span class="hero__mobile-main">HỌC LẬP TRÌNH</span>&nbsp;<span class="hero__mobile-highlight">ASTRO THỰC CHIẾN</span>',
        },
        { text: 'Hành trình vạn dặm từ những dòng code đầu tiên', kind: 'type' },
        { text: 'Trang bị "Vũ trụ công nghệ" để bứt phá từ F0.', kind: 'glow' },
      ];

      const showStep = async (step) => {
        mobileLine.classList.remove('is-glow');
        mobileLine.classList.remove('is-visible');
        mobileOutput.textContent = '';
        await wait(mobileFadeInDelay);
        mobileLine.classList.add('is-visible');

        if (step.kind === 'type') {
          await typeText(mobileOutput, step.text, mobileTypeSpeed);
          await wait(mobileHoldAfterType);
        } else {
          if (step.kind === 'slide' && step.html) {
            mobileOutput.innerHTML = step.html;
          } else {
            mobileOutput.textContent = step.text;
          }
          if (step.kind === 'glow') mobileLine.classList.add('is-glow');
          await wait(mobileHoldStatic);
        }

        mobileLine.classList.remove('is-visible');
        await wait(mobileFadeOutGap);
      };

      const runMobileLoop = async () => {
        while (true) {
          for (const step of steps) {
            await showStep(step);
          }
        }
      };
      runMobileLoop();
    }
  }
</script>