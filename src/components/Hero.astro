---
import img1 from '../assets/1.webp';
import img2 from '../assets/2.webp';
import img3 from '../assets/3.webp';
import img4 from '../assets/4.webp';
import img5 from '../assets/5.webp';
import img6 from '../assets/6.webp';
import img7 from '../assets/7.webp';
import img8 from '../assets/8.webp';
import img9 from '../assets/9.webp';

const heroImages = [img1, img2, img3, img4, img5, img6, img7, img8, img9].map((img, index) => ({
  src: img.src,
  width: img.width,
  height: img.height,
  alt: `Ảnh hero ${index + 1}`,
}));
---

<section 
  class="hero group relative mb-6 overflow-hidden rounded-[24px] border transition-all duration-500
         bg-slate-50 border-slate-200 p-4 sm:p-6 md:p-8 lg:p-4
         dark:bg-slate-950 dark:border-slate-800"
>
  <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-orange-500/5 blur-[70px] z-0"></div>

  <div class="relative z-10 max-w-5xl lg:max-w-2xl mx-auto">
    <div class="overflow-hidden rounded-[20px] ring-1 ring-slate-200/80 dark:ring-white/10 bg-white/60 dark:bg-white/5">
      <div id="hero-image-slot" class="w-full bg-slate-200/40 dark:bg-white/5"></div>
    </div>
  </div>
</section>

<script type="application/json" id="hero-images" set:html={JSON.stringify(heroImages)}></script>

<script>
  const slot = document.getElementById('hero-image-slot');
  const jsonEl = document.getElementById('hero-images');
  if (slot instanceof HTMLElement && jsonEl instanceof HTMLScriptElement) {
    const list = JSON.parse(jsonEl.textContent || '[]');
    if (Array.isArray(list) && list.length > 0) {
      const key = 'dt-hero-seq-index';
      const current = Number.parseInt(localStorage.getItem(key) || '0', 10);
      const safe = Number.isFinite(current) ? current : 0;
      const idx = ((safe % list.length) + list.length) % list.length;
      const next = (idx + 1) % list.length;
      localStorage.setItem(key, String(next));

      const pick = list[idx];
      if (pick && typeof pick.src === 'string') {
        const preload = document.createElement('link');
        preload.rel = 'preload';
        preload.as = 'image';
        preload.href = pick.src;
        preload.fetchPriority = 'high';
        document.head.appendChild(preload);

        const wrap = document.createElement('div');
        wrap.className = 'relative w-full overflow-hidden';

        const bg = document.createElement('div');
        bg.className = 'absolute inset-0 opacity-50 scale-[1.08]';
        bg.style.backgroundImage = `url(${pick.src})`;
        bg.style.backgroundSize = 'cover';
        bg.style.backgroundPosition = 'center';
        bg.style.filter = 'blur(18px)';
        bg.setAttribute('aria-hidden', 'true');

        const img = document.createElement('img');
        img.src = pick.src;
        img.alt = typeof pick.alt === 'string' ? pick.alt : '';
        if (typeof pick.width === 'number') img.width = pick.width;
        if (typeof pick.height === 'number') img.height = pick.height;
        img.decoding = 'async';
        img.loading = 'eager';
        img.fetchPriority = 'high';
        img.className = 'relative z-10 w-full h-auto';

        wrap.appendChild(bg);
        wrap.appendChild(img);
        slot.replaceChildren(wrap);
      }
    }
  }
</script>
