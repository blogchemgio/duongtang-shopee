---
// ChatBot.astro - Phiên bản "Thằng Tèo" 2026: Hệ Llama 3.2 (Cloudflare AI)
---

<div class="fixed bottom-5 left-5 z-[999] flex flex-col-reverse items-start font-sans text-left">
  <button id="chat-toggle" class="bg-orange-500 hover:bg-orange-600 text-white p-4 rounded-full shadow-lg transition-all hover:scale-110 active:scale-95 border-none outline-none cursor-pointer">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
    </svg>
  </button>

  <div id="chat-window" class="hidden flex-col w-80 sm:w-96 h-[500px] bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-2xl mb-4 overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-300">
    <div class="bg-orange-500 p-4 text-white font-bold flex justify-between items-center shadow-md flex-shrink-0 text-left">
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
        <span>Đệ tử Admin - Thằng Tèo 🌸</span>
      </div>
      <button id="close-chat" class="hover:bg-orange-600 px-2 rounded text-2xl border-none outline-none cursor-pointer">×</button>
    </div>
    
    <div id="chat-content" class="flex-1 p-4 overflow-y-auto overflow-x-hidden text-sm bg-gray-50 dark:bg-gray-900 custom-scrollbar flex flex-col gap-4 scroll-smooth">
      <div class="bg-orange-500 text-white p-3 rounded-2xl rounded-tr-none self-end max-w-[85%] shadow-sm msg-animate whitespace-pre-wrap text-left">
        Tèo đây sếp Đức ơi! Đại ca muốn chém gió gì hay mua hoa thì hú em nhé! Hihi! 🚀
      </div>
    </div>

    <div class="p-3 border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 flex-shrink-0">
      <div class="flex items-center bg-gray-100 dark:bg-gray-700 rounded-2xl px-3 py-1 border border-transparent focus-within:border-orange-500 transition-all">
        <input 
          id="chat-input" 
          type="text" 
          placeholder="Nhập nội dung chém gió..." 
          class="flex-1 bg-transparent py-2 text-sm outline-none border-none focus:ring-0 text-black dark:text-white placeholder:text-gray-500 text-left"
        />
        <button id="send-btn" class="ml-1 p-1 text-orange-500 hover:text-orange-600 active:scale-90 border-none outline-none cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 rotate-90" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #fb923c; border-radius: 10px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }

  .msg-animate { animation: msgPop 0.25s ease-out forwards; }
  @keyframes msgPop {
    from { opacity: 0; transform: translateY(8px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  #chat-window { display: none; max-height: calc(100vh - 100px); }
  #chat-window.flex { display: flex; }
</style>

<script>
  // ĐỊA CHỈ WORKER CỦA SẾP
  const WORKER_URL = 'https://astro-chat.bloggerchemgio.workers.dev/';
  
  const chatInput = document.getElementById('chat-input') as HTMLInputElement;
  const chatContent = document.getElementById('chat-content');
  const chatWindow = document.getElementById('chat-window');
  const chatToggle = document.getElementById('chat-toggle');
  const closeChat = document.getElementById('close-chat');
  const sendBtn = document.getElementById('send-btn');

  function scrollToBottom() {
    if (chatContent) chatContent.scrollTop = chatContent.scrollHeight;
  }

  function toggleChat() {
    chatWindow?.classList.toggle('hidden');
    chatWindow?.classList.toggle('flex');
    if (chatWindow && !chatWindow.classList.contains('hidden')) {
        chatInput?.focus();
        scrollToBottom();
    }
  }

  chatToggle?.addEventListener('click', (e) => { e.stopPropagation(); toggleChat(); });
  closeChat?.addEventListener('click', (e) => { e.stopPropagation(); toggleChat(); });

  async function handleSendMessage() {
    const text = chatInput.value.trim();
    if (!text) return;

    appendMessage(text, 'user');
    chatInput.value = '';
    
    const botMsgId = 'teo-' + Date.now();
    appendMessage('...', 'bot', botMsgId);
    const botMsgElem = document.getElementById(botMsgId);

    try {
      const res = await fetch(WORKER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text })
      });

      if (!res.body) throw new Error("Mất kết nối server!");

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let fullText = "";
      let buffer = ""; 

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        let lines = buffer.split('\n');
        buffer = lines.pop() || ""; 

        for (const line of lines) {
          const trimmedLine = line.trim();
          if (!trimmedLine || trimmedLine === 'data: [DONE]') continue;

          // Xử lý định dạng data: {"response": "..."}
          if (trimmedLine.startsWith('data: ')) {
            try {
              const jsonStr = trimmedLine.substring(6);
              const data = JSON.parse(jsonStr);
              
              // Worker Llama trả về key "response"
              const chunkText = data.response;

              if (chunkText) {
                if (botMsgElem && botMsgElem.innerText === "...") {
                  botMsgElem.innerText = "";
                }
                fullText += chunkText;
                if (botMsgElem) {
                  botMsgElem.innerText = fullText;
                  scrollToBottom();
                }
              }
            } catch (e) {
              // Có thể là mảnh JSON chưa hoàn chỉnh, bỏ qua đợi mảnh tiếp theo
            }
          }
        }
      }
    } catch (err) {
      if (botMsgElem) botMsgElem.innerText = "Hết cứu! Tèo xịt keo cứng ngắc vì lag rồi sếp Đức ơi! 🌸🚀";
      scrollToBottom();
    }
  }

  function appendMessage(content: string, sender: 'user' | 'bot', id?: string) {
    if (!chatContent) return;
    const div = document.createElement('div');
    if (id) div.id = id;
    
    div.className = `p-3 rounded-2xl text-sm max-w-[85%] shadow-sm msg-animate whitespace-pre-wrap text-left ${
      sender === 'user' 
        ? "bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-800 dark:text-gray-200 self-start rounded-tl-none" 
        : "bg-orange-500 text-white self-end rounded-tr-none"
    }`;

    div.innerText = content;
    chatContent.appendChild(div);
    scrollToBottom();
  }

  sendBtn?.addEventListener('click', handleSendMessage);
  chatInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') handleSendMessage();
  });

  document.addEventListener('mousedown', (event) => {
    if (chatWindow && !chatWindow.contains(event.target as Node) && chatToggle && !chatToggle.contains(event.target as Node)) {
      chatWindow.classList.add('hidden');
      chatWindow.classList.remove('flex');
    }
  });
</script>