---

<aside class="shopee-map-sidebar">
  <div class="p-4 md:p-6 rounded-[24px] md:rounded-[32px] bg-[#efe7d2] dark:bg-white/5 border border-black/5 dark:border-white/10 shadow-sm">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#EB6658]/10 text-[#EB6658] text-[9px] font-black uppercase tracking-widest mb-4 md:mb-6">
      <span class="relative flex h-1.5 w-1.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#EB6658] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#EB6658]"></span>
      </span>
      Bản Đồ Thỉnh Deal
    </div>

    <div class="flex flex-col gap-5 md:gap-8">
      {categoryGroups.map((group) => (
        <div class="flex flex-col gap-2.5 md:gap-4">
          <div class="flex items-center gap-2 md:gap-2.5">
            <span class="text-base md:text-lg">{group.icon}</span>
            <h3 class="text-[10px] md:text-[11px] font-black text-slate-900 dark:text-white uppercase tracking-wider">
              {group.title}
            </h3>
          </div>
          <div class="flex flex-wrap gap-1 md:gap-1.5">
            {group.items.map((item) => (
              <a 
                href={item.affLink} 
                target="_blank" 
                rel="noopener noreferrer"
                class="px-2.5 py-1 md:px-3 md:py-1.5 rounded-lg md:rounded-xl bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/5 text-[9px] md:text-[10px] font-bold text-slate-600 dark:text-slate-300 transition-all hover:bg-[#EB6658] hover:text-white hover:border-[#EB6658] active:scale-95 whitespace-nowrap"
              >
                {item.name}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-6 md:mt-8 p-4 md:p-5 rounded-[20px] md:rounded-[24px] bg-[#efe7d2] dark:bg-black/20 border border-black/5 dark:border-white/5">
      <p class="text-[9px] md:text-[10px] font-black text-[#ff7a18] uppercase tracking-widest mb-2 md:mb-3">⚡ Bí kíp Đường Tăng</p>
      <p class="text-[10px] md:text-[11px] font-medium text-slate-600 dark:text-slate-400 leading-relaxed italic">
        Thỉnh đồ Shopee, thí chủ hãy chọn danh mục quan tâm để nhận ngay duyên lành giảm giá. Thiện tai!
      </p>
    </div>
  </div>
</aside>

<style>
  .shopee-map-sidebar {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  }
</style>
