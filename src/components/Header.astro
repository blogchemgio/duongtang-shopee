---
// Header.astro
import MobileSearch from './MobileSearch.astro';
import menuMobileBg1 from '../assets/menu-mobile-1.webp';
import menuMobileBg2 from '../assets/menu-mobile-2.webp';

const desktopLinks = [
  { href: '/gioi-thieu', label: 'Giới thiệu' },
  { href: '/blog', label: 'Đường Tăng' },
  { href: '/bat-gioi-review', label: 'Bát Giới' },
  { href: '/ngo-khong-tech', label: 'Ngộ Không' },
  { href: '/sa-tang-decor', label: 'Sa Tăng' },
  { href: '/lien-he', label: 'Liên hệ' },
];

const mobileLinks = [
  { href: '/blog', label: 'Đường Tăng Blog', icon: '✎' },
  { href: '/bat-gioi-review', label: 'Bát Giới Ẩm Thực', icon: '▣' },
  { href: '/ngo-khong-tech', label: 'Ngộ không tech', icon: '◈' },
  { href: '/sa-tang-decor', label: 'sa tăng decor', icon: '✦' },
  { href: '/gioi-thieu', label: 'About', icon: '◎' },
  { href: '/lien-he', label: 'Contact', icon: '✉' },
  { href: '/sitemap', label: 'Sitemap', icon: '☰' },
];
---

<header id="main-header" class="fixed top-0 left-0 right-0 bg-[#efe7d2] dark:bg-[#121212] py-4 z-[100] transition-transform duration-500 ease-in-out border-b border-black/5 dark:border-white/5">
  <div class="w-full max-w-none px-2 md:px-10 lg:px-16 flex justify-between items-center">
    <div class="flex items-center gap-3">
      <!-- NÚT MENU MOBILE -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-[#1a1a1a] dark:text-[#EB6658] transition-all dt-home-glow" aria-label="Open Menu">
        <div id="home-icon-svg" class="w-7 h-7 flex items-center justify-center">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </div>
      </button>

      <a href="/" class="logo-link ml-1 text-xl md:text-2xl font-black tracking-tighter text-[#1a1a1a] dark:text-white whitespace-nowrap transition-all uppercase font-['Inter']">
        <span class="logo-text">Đường Tăng</span><span class="logo-vn text-[#EB6658]">.vn</span>
      </a>
    </div>

    <nav class="hidden lg:block">
      <ul class="flex gap-8 text-[11px] font-bold uppercase tracking-[0.15em] text-[#1a1a1a] dark:text-[#e8e0d1]">
        {desktopLinks.map((link) => (
          <li><a href={link.href} class="nav-item hover:text-[#EB6658] transition-colors">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <div class="header-search">
        <MobileSearch inputId="header-search-input" placeholder="Tìm kiếm..." />
      </div>
    </div>
  </div> 
</header>

<!-- Spacer để không bị đè nội dung -->
<div class="h-[68px] md:h-[76px] bg-[#efe7d2] dark:bg-[#121212]"></div>

<!-- SIDEBAR MOBILE -->
<aside
  id="mobile-sidebar"
  class="fixed top-0 left-0 h-full w-[300px] bg-[#efe7d2] dark:bg-[#1a1a1a] z-[140] transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col border-r border-black/5 dark:border-white/5 shadow-2xl"
  data-bg1={menuMobileBg1.src}
  data-bg2={menuMobileBg2.src}
>
  <div class="h-20 border-b border-black/5 dark:border-white/10 flex items-center justify-between px-6">
    <a href="/" class="top-home-link text-[#1a1a1a] dark:text-white font-bold uppercase text-sm flex items-center gap-2">
      <span class="menu-icon text-[#EB6658]">⌂</span>Home
    </a>
    <button id="close-sidebar" class="p-2 text-[#1a1a1a] dark:text-white hover:rotate-90 hover:text-[#EB6658] transition-all duration-300">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="flex-grow overflow-y-auto pt-10 px-8 relative z-10">
    <ul class="flex flex-col gap-6">
      {mobileLinks.map((link) => (
        <li>
          <a href={link.href} class="sidebar-link !text-[#1a1a1a] dark:!text-[#e8e0d1]">
            <span class="menu-icon text-[#EB6658]">{link.icon}</span>{link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<div id="menu-overlay" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[135] hidden opacity-0 transition-opacity duration-300"></div>

<style is:global>
  #main-header { will-change: transform; font-family: 'Inter', sans-serif; }
  
  /* Lớp phủ cho Mobile Sidebar khi dùng ảnh nền */
  #mobile-sidebar::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgba(239, 231, 210, 0.85); /* Màu kem phủ lên ảnh */
    z-index: 0;
  }
  :global(.is-dark) #mobile-sidebar::before {
    background-color: rgba(26, 26, 26, 0.9);
  }

  .header-actions { display: flex; align-items: center; gap: 0.6rem; }
  
  #mobile-sidebar { 
    background-image: var(--menu-mobile-bg, none); 
    background-size: cover; 
    background-position: center; 
  }

  .logo-vn { text-shadow: 0 0 12px rgba(235, 102, 88, 0.2); }

  /* HIỆU ỨNG HÀO QUANG ĐỎ CAM */
  .dt-home-glow {
    filter: drop-shadow(0 0 8px rgba(235, 102, 88, 0.2));
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    transition: all 0.3s ease !important;
    position: relative;
    z-index: 10;
  }
  .sidebar-link:hover {
    color: #EB6658 !important;
    transform: translateX(8px) !important;
  }
</style>

<!-- Script giữ nguyên logic cũ của bạn -->
<script>
  // ... (Phần script giữ nguyên như file cũ của bạn)
  // Chỉ thay đổi màu sắc hex trong các biến nếu cần thiết
</script>