---
// Header.astro
import MobileSearch from './MobileSearch.astro';
import menuMobileBg1 from '../assets/menu-mobile-1.webp';
import menuMobileBg2 from '../assets/menu-mobile-2.webp';

const desktopLinks = [
  { href: '/gioi-thieu', label: 'Giới thiệu' },
  { href: '/blog', label: 'Đường Tăng' },
  { href: '/bat-gioi-review', label: 'Bát Giới' },
  { href: '/ngo-khong-tech', label: 'Ngộ Không' },
  { href: '/sa-tang-decor', label: 'Sa Tăng' },
  { href: '/lien-he', label: 'Liên hệ' },
];

const mobileLinks = [
  { href: '/blog', label: 'Đường Tăng Blog', icon: '✎' },
  { href: '/bat-gioi-review', label: 'Bát Giới Ẩm Thực', icon: '▣' },
  { href: '/ngo-khong-tech', label: 'Ngộ không tech', icon: '◈' },
  { href: '/sa-tang-decor', label: 'sa tăng decor', icon: '✦' },
  { href: '/gioi-thieu', label: 'About', icon: '◎' },
  { href: '/lien-he', label: 'Contact', icon: '✉' },
  { href: '/sitemap', label: 'Sitemap', icon: '☰' },
];
---

<header id="main-header" class="fixed top-0 left-0 right-0 bg-white dark:bg-[#020617] py-4 z-[100] transition-transform duration-500 ease-in-out border-b border-slate-100 dark:border-slate-800">
  <div class="w-full max-w-none px-2 md:px-10 lg:px-16 flex justify-between items-center">
    <div class="flex items-center gap-3">
      <!-- NÚT MENU MOBILE BIẾN HÓA ICON -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-950 dark:text-[#ff7a18] transition-all dt-home-glow" aria-label="Open Menu">
        <div id="home-icon-svg" class="w-7 h-7 flex items-center justify-center">
          <!-- Icon mặc định (Ngôi nhà) sẽ hiện trước khi JS chạy -->
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </div>
      </button>

      <a href="/" class="logo-link ml-1 text-xl md:text-2xl font-black tracking-tighter text-slate-950 dark:text-white whitespace-nowrap transition-all uppercase">
        <span class="logo-text">Đường Tăng</span><span class="logo-vn">.vn</span>
      </a>
    </div>

    <nav class="hidden lg:block">
      <ul class="flex gap-8 text-[11px] font-bold uppercase tracking-[0.15em] text-slate-950 dark:text-white">
        {desktopLinks.map((link) => (
          <li><a href={link.href} class="nav-item">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <div class="header-search">
        <MobileSearch inputId="header-search-input" placeholder="Tìm kiếm bài viết..." />
      </div>
    </div>
  </div> 
</header>

<div class="h-[68px] md:h-[76px]"></div>

<!-- SIDEBAR MOBILE -->
<aside
  id="mobile-sidebar"
  class="fixed top-0 left-0 h-full w-[300px] bg-[#0f172b] z-[140] transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col border-r border-slate-800 shadow-2xl"
  data-bg1={menuMobileBg1.src}
  data-bg2={menuMobileBg2.src}
>
  <div class="h-20 border-b border-slate-800 flex items-center justify-between px-6">
    <a href="/" class="top-home-link text-white"><span class="menu-icon">⌂</span>Home</a>
    <button id="close-sidebar" class="p-2 text-white hover:rotate-90 hover:text-[#ff7a18] transition-all duration-300">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="flex-grow overflow-y-auto pt-10 px-8">
    <ul class="flex flex-col gap-6">
      {mobileLinks.map((link) => (
        <li>
          <a href={link.href} class="sidebar-link !text-white">
            <span class="menu-icon">{link.icon}</span>{link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<div id="menu-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-md z-[135] hidden opacity-0 transition-opacity duration-300"></div>

<style is:global>
  #main-header { will-change: transform; }
  .header-actions { display: flex; align-items: center; gap: 0.6rem; }
  .header-search { position: relative; }
  #mobile-sidebar { 
    background-image: var(--menu-mobile-bg, none); 
    background-size: cover; 
    background-position: center; 
  }

  .logo-link { text-shadow: 0 0 10px rgba(255, 122, 24, 0.18); }
  .logo-vn { color: #ff7a18; text-shadow: 0 0 12px rgba(255, 122, 24, 0.35); }

  /* HIỆU ỨNG HÀO QUANG CHO ICON BIẾN HÓA */
  .dt-home-glow {
    filter: drop-shadow(0 0 8px rgba(255, 122, 24, 0.35));
    animation: dt-home-glow-pulse 2.4s ease-in-out infinite;
  }
  @keyframes dt-home-glow-pulse {
    0%, 100% { filter: drop-shadow(0 0 8px rgba(255, 122, 24, 0.28)); }
    50% { filter: drop-shadow(0 0 16px rgba(255, 122, 24, 0.55)); }
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.15rem;
    font-weight: 800;
    text-transform: uppercase;
    transition: all 0.3s ease !important;
  }
  .sidebar-link:hover {
    color: #ff7a18 !important;
    transform: translateX(10px) !important;
  }
  .nav-item:hover { color: #ff7a18 !important; }
</style>

<script>
  // --- KHO BÁT BẢO ICON ---
  const icons = {
    lotus: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-1 3-5 5-8 5s-3-2-3-2 1 6 6 8c-3 2-4 5-4 5s4-1 7-4c3 3 7 4 7 4s-1-3-4-5c5-2 6-8 6-8s-1 2-3 2-7-2-8-5Z"/><path d="M12 13v8"/><path d="M8 21h8"/></svg>',
    yinyang: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 0 20 10 10 0 0 1 0-20z"/><path d="M12 2v20"/><path d="M12 7a2.5 2.5 0 0 1 0 5 2.5 2.5 0 0 0 0 5"/><circle cx="12" cy="9.5" r=".5" fill="currentColor"/><circle cx="12" cy="14.5" r=".5" fill="currentColor"/></svg>',
    shrine: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 21h20"/><path d="M4 21v-7"/><path d="M20 21v-7"/><path d="M2 14h20"/><path d="M5 8h14"/><path d="M8 14V8"/><path d="M16 14V8"/><path d="M3 8c0-2.8 2.2-5 5-5h8c2.8 0 5 2.2 5 5"/></svg>',
    sun: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="M4.93 4.93l1.41 1.41"/><path d="M17.66 17.66l1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="M6.34 17.66l-1.41 1.41"/><path d="M19.07 4.93l-1.41 1.41"/></svg>',
    connect: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>',
    command: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3H6a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3 3 3 0 0 0-3 3 3 3 0 0 0 3 3h12a3 3 0 0 0 3-3 3 3 0 0 0-3-3z"/></svg>',
    home: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
    shopee: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8.5V6a6 6 0 0 1 12 0v2.5"/><rect x="3" y="8" width="18" height="13" rx="3"/><path d="M9 13.5c1.5-1 3.5 1 5 0s0-3-2-3-3.5 1-3.5 3c0 2.5 4.5 2.5 4.5 5 0 2-1.5 3-3.5 2s-3.5-1-5 0"/></svg>'
  };

  function setRandomIcon() {
    const container = document.getElementById('home-icon-svg');
    if (!container) return;
    const keys = Object.keys(icons);
    const randomKey = keys[Math.floor(Math.random() * keys.length)];
    container.innerHTML = icons[randomKey];
  }

  const header = document.getElementById('main-header');
  const btnOpen = document.getElementById('mobile-menu-btn');
  const btnClose = document.getElementById('close-sidebar');
  const sidebar = document.getElementById('mobile-sidebar');
  const overlay = document.getElementById('menu-overlay');
  let openCount = 0;

  // --- SMART HEADER ---
  let lastScrollY = window.scrollY;
  window.addEventListener('scroll', () => {
    if (!header) return;
    const currentScrollY = window.scrollY;
    if (currentScrollY > lastScrollY && currentScrollY > 100) {
      header.style.transform = 'translateY(-100%)';
    } else {
      header.style.transform = 'translateY(0)';
    }
    lastScrollY = currentScrollY;
  }, { passive: true });

  // --- SIDEBAR LOGIC ---
  function toggleMenu(state) {
    if (state) {
      if (sidebar instanceof HTMLElement) {
        const candidates = [sidebar.dataset.bg1, sidebar.dataset.bg2].filter(Boolean);
        const pick = candidates.length > 0 ? candidates[openCount % candidates.length] : undefined;
        openCount += 1;
        if (pick) sidebar.style.setProperty('--menu-mobile-bg', `url(${pick})`);
      }
      sidebar?.classList.remove('-translate-x-full');
      overlay?.classList.remove('hidden');
      setTimeout(() => overlay?.classList.add('opacity-100'), 10);
      document.body.style.overflow = 'hidden';
    } else {
      sidebar?.classList.add('-translate-x-full');
      overlay?.classList.remove('opacity-100');
      setTimeout(() => overlay?.classList.add('hidden'), 300);
      document.body.style.overflow = '';
    }
  }

  btnOpen?.addEventListener('click', () => toggleMenu(true));
  btnClose?.addEventListener('click', () => toggleMenu(false));
  overlay?.addEventListener('click', () => toggleMenu(false));
  
  // Khởi chạy ngẫu nhiên icon
  setRandomIcon();

  // Hỗ trợ View Transitions
  document.addEventListener('astro:after-swap', () => {
    setRandomIcon();
  });
</script>