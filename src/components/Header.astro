<header class="sticky top-0 z-[100] w-full bg-slate-950/80 backdrop-blur-md border-b border-white/10">
  <div class="max-w-7xl mx-auto px-6 py-4">
    <nav class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 group transition-transform active:scale-95">
        <span class="text-white font-bold text-2xl md:text-3xl tracking-tighter uppercase drop-shadow-lg">Đường tăng<span class="text-[#ff7a18]">.vn</span></span>
      </a>

      <div class="hidden md:flex items-center gap-6 lg:gap-8 text-sm lg:text-lg font-bold text-white/90">
        <a href="/duong-tang-blog" class="hover:text-[#ff7a18] transition-colors drop-shadow-md">Đường tăng</a>
        <a href="/bat-gioi-review" class="hover:text-[#ff7a18] transition-colors drop-shadow-md">Bát giới</a>
        <a href="/plugins" class="hover:text-[#ff7a18] transition-colors drop-shadow-md">Ngộ không</a>
        <a href="/themes" class="hover:text-[#ff7a18] transition-colors drop-shadow-md">Sa tăng</a>
        <a href="/gioi-thieu" class="hover:text-[#ff7a18] transition-colors drop-shadow-md">Giới thiệu</a>
