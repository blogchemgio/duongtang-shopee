---
// Header.astro
import MobileSearch from './MobileSearch.astro';
import menuMobileBg1 from '../assets/menu-mobile-1.webp';
import menuMobileBg2 from '../assets/menu-mobile-2.webp';

const desktopLinks = [
  { href: '/blog', label: 'Đường Tăng' },
  { href: '/bat-gioi-review', label: 'Bát Giới' },
  { href: '/ngo-khong-tech', label: 'ngộ không' },
  { href: '/sa-tang-decor', label: 'sa tăng' },
  { href: '/gioi-thieu', label: 'Giới thiệu' },
  { href: '/lien-he', label: 'Liên hệ' },
];

const mobileLinks = [
  { href: '/blog', label: 'Đường Tăng Blog', icon: '✎' },
  { href: '/bat-gioi-review', label: 'Bát Giới Ẩm Thực', icon: '▣' },
  { href: '/ngo-khong-tech', label: 'Ngộ không tech', icon: '◈' },
  { href: '/sa-tang-decor', label: 'sa tăng decor', icon: '✦' },
  { href: '/gioi-thieu', label: 'About', icon: '◎' },
  { href: '/lien-he', label: 'Contact', icon: '✉' },
  { href: '/sitemap', label: 'Sitemap', icon: '☰' },
];
---
<header id="main-header" class="fixed top-0 left-0 right-0 bg-white dark:bg-[#020617] py-4 z-[100] transition-transform duration-500 ease-in-out border-b border-slate-100 dark:border-slate-800">
  <div class="w-full max-w-none px-2 md:px-10 lg:px-16 flex justify-between items-center">
    <div class="flex items-center gap-3">
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-950 dark:text-[#ff7a18] transition-all dt-home-glow" aria-label="Open Menu">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
      </button>

      <a href="/" class="logo-link ml-1 text-xl md:text-2xl font-black tracking-tighter text-slate-950 dark:text-white whitespace-nowrap transition-all">
        <span class="logo-text">Đường Tăng</span><span class="logo-vn">.vn</span>
      </a>
    </div>

    <nav class="hidden lg:block">
      <ul class="flex gap-8 text-[11px] font-bold uppercase tracking-[0.15em] text-slate-950 dark:text-white">
        {desktopLinks.map((link) => (
          <li><a href={link.href} class="nav-item">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <div class="header-search">
        <MobileSearch inputId="header-search-input" placeholder="Tìm kiếm bài viết..." />
      </div>
    </div>
  </div> 
</header>

<div class="h-[68px] md:h-[76px]"></div>

<aside
  id="mobile-sidebar"
  class="fixed top-0 left-0 h-full w-[300px] bg-[#0f172b] z-[140] transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col border-r border-slate-800 shadow-2xl"
  data-bg1={menuMobileBg1.src}
  data-bg2={menuMobileBg2.src}
>
  
  <div class="h-20 border-b border-slate-800 flex items-center justify-between px-6">
    <a href="/" class="top-home-link"><span class="menu-icon">⌂</span>Home</a>
    <button id="close-sidebar" class="p-2 hover:rotate-90 hover:text-[#ff7a18] transition-all duration-300">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <div class="flex-grow overflow-y-auto pt-10 px-8">
    <ul class="flex flex-col gap-6">
      {mobileLinks.map((link) => (
        <li>
          <a href={link.href} class="sidebar-link">
            <span class="menu-icon">{link.icon}</span>{link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<div id="menu-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-md z-[135] hidden opacity-0 transition-opacity duration-300"></div>

<style is:global>
  /* --- SMART HEADER ANIMATION --- */
  #main-header {
    will-change: transform;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .header-search {
    position: relative;
    width: 430px;
  }

  .header-search :global(.mobile-search) {
    position: relative;
    z-index: 120;
  }

  #mobile-sidebar {
    background-image: var(--menu-mobile-bg, none);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .logo-link {
    text-shadow: 0 0 10px rgba(255, 122, 24, 0.18), 0 0 28px rgba(255, 122, 24, 0.12);
  }

  .logo-vn {
    color: #ff7a18;
    text-shadow: 0 0 12px rgba(255, 122, 24, 0.35), 0 0 32px rgba(255, 122, 24, 0.18);
  }

  .dt-home-glow {
    filter: drop-shadow(0 0 10px rgba(255, 122, 24, 0.35));
    animation: dt-home-glow-pulse 2.4s ease-in-out infinite;
  }

  @keyframes dt-home-glow-pulse {
    0%,
    100% {
      filter: drop-shadow(0 0 8px rgba(255, 122, 24, 0.28));
      transform: translateZ(0);
    }
    50% {
      filter: drop-shadow(0 0 16px rgba(255, 122, 24, 0.55));
      transform: translateZ(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dt-home-glow {
      animation: none;
    }
  }

  /* --- SIDEBAR LINKS (CĂN TRÁI & MÀU TRẮNG) --- */
  .sidebar-link {
    display: flex;
    align-items: center;
    justify-content: flex-start; /* Căn trái */
    gap: 1rem;
    font-size: 1.15rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #020617; 
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
  }

  .menu-icon {
    color: #020617;
    font-size: 1.1em;
    min-width: 24px;
    display: flex;
    justify-content: center;
  }

  .top-home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #020617;
  }

  #close-sidebar {
    color: #020617;
  }

  /* --- HOVER EFFECT --- */
  .sidebar-link:hover, .sidebar-link:active,
  .top-home-link:hover, .top-home-link:active {
    color: #ff7a18 !important; /* Chuyển Cam khi hover */
    transform: translateX(10px) !important; /* Trượt sang phải */
    text-shadow: 0 0 10px rgba(255, 122, 24, 0.4) !important;
  }
  
  /* Hover effect Desktop Desktop Nav Item */
  .nav-item {
    transition: color 0.3s;
  }
  .nav-item:hover {
    color: #ff7a18 !important;
  }

  /* Khử style mặc định */
  ul, li { list-style: none !important; padding: 0; margin: 0; }
  a { text-decoration: none !important; }

  @media (max-width: 1023px) {
    .header-search {
      width: auto;
    }
  }
</style>

<script>
  const header = document.getElementById('main-header');
  const btnOpen = document.getElementById('mobile-menu-btn');
  const btnClose = document.getElementById('close-sidebar');
  const sidebar = document.getElementById('mobile-sidebar');
  const overlay = document.getElementById('menu-overlay');
  let openCount = 0;

  // --- LOGIC SMART HEADER ---
  let lastScrollY = window.scrollY;
  window.addEventListener('scroll', () => {
    if (!header) return;
    const currentScrollY = window.scrollY;
    if (currentScrollY > lastScrollY && currentScrollY > 100) {
      header.style.transform = 'translateY(-100%)';
    } else {
      header.style.transform = 'translateY(0)';
    }
    lastScrollY = currentScrollY;
  }, { passive: true });

  // --- LOGIC SIDEBAR ---
  function toggleMenu(state) {
    if (state) {
      if (sidebar instanceof HTMLElement) {
        const candidates = [sidebar.dataset.bg1, sidebar.dataset.bg2].filter(Boolean);
        const pick = candidates.length > 0 ? candidates[openCount % candidates.length] : undefined;
        openCount += 1;
        if (pick) sidebar.style.setProperty('--menu-mobile-bg', `url(${pick})`);
      }
      sidebar?.classList.remove('-translate-x-full');
      overlay?.classList.remove('hidden');
      setTimeout(() => overlay?.classList.add('opacity-100'), 10);
      document.body.style.overflow = 'hidden';
      if (header) header.style.transform = 'translateY(0)';
    } else {
      sidebar?.classList.add('-translate-x-full');
      overlay?.classList.remove('opacity-100');
      setTimeout(() => overlay?.classList.add('hidden'), 300);
      document.body.style.overflow = '';
    }
  }

  btnOpen?.addEventListener('click', () => toggleMenu(true));
  btnClose?.addEventListener('click', () => toggleMenu(false));
  overlay?.addEventListener('click', () => toggleMenu(false));
  sidebar?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => toggleMenu(false));
  });
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') toggleMenu(false);
  });
</script>
