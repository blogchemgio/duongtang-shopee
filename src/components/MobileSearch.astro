---
const {
  action = '/tim-kiem',
  placeholder = 'Tìm kiếm nội dung...',
  inputId = 'site-search-input',
} = Astro.props;
---

<form class="mobile-search" method="GET" action={action} role="search" data-mobile-search>
  <button
    type="button"
    class="mobile-search__toggle"
    aria-label="Mở tìm kiếm"
    aria-expanded="false"
    aria-controls={inputId}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
    </svg>
  </button>
  <input
    id={inputId}
    class="mobile-search__input"
    type="search"
    name="q"
    placeholder={placeholder}
    autocomplete="off"
  />
  <button type="submit" class="mobile-search__submit">Tìm kiếm</button>
</form>
<div class="mobile-search__overlay" data-mobile-search-overlay aria-hidden="true"></div>

<style>
  .mobile-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid rgba(249, 115, 22, 0.45);
    border-radius: 99px;
    background: #fff7ed;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .mobile-search__toggle {
    display: none; /* Mặc định ẩn trên desktop */
    width: 32px;
    height: 32px;
    min-width: 32px;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: #ea580c;
    cursor: pointer;
    padding: 0;
    border-radius: 99px;
  }

  .mobile-search__toggle svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mobile-search__input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: #7c2d12;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0 0.5rem;
    width: 180px; /* Độ rộng cố định trên desktop */
  }

  .mobile-search__submit {
    border: none;
    border-radius: 99px;
    background: linear-gradient(135deg, #fb923c 0%, #ea580c 100%);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.7rem;
    text-transform: uppercase;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .mobile-search__overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(2, 6, 23, 0.3);
    backdrop-filter: blur(4px);
    z-index: 130;
  }

  /* --- MOBILE LOGIC (Dưới 1024px) --- */
  @media (max-width: 1023px) {
    .mobile-search {
      width: 40px;
      height: 40px;
      padding: 0;
      background: transparent;
      justify-content: center;
      overflow: hidden;
    }

    .mobile-search__toggle {
      display: flex; /* Hiện nút kính lúp trên mobile */
    }

    .mobile-search__input, 
    .mobile-search__submit {
      display: none; /* Ẩn input và nút gửi trên mobile khi chưa mở */
    }

    /* Khi ở trạng thái mở trên mobile */
    .mobile-search--open {
      position: fixed !important;
      left: 50%;
      top: 100px;
      transform: translateX(-50%);
      width: min(90vw, 400px);
      height: auto;
      padding: 0.6rem 0.8rem;
      background: #fff7ed;
      z-index: 140;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
      display: flex;
    }

    .mobile-search--open .mobile-search__input {
      display: block;
      width: 100%;
    }

    .mobile-search--open .mobile-search__submit {
      display: block;
    }

    .mobile-search--open + .mobile-search__overlay {
      display: block;
    }
  }

  /* --- DARK MODE --- */
  :global(.dark) .mobile-search {
    background: rgba(15, 23, 42, 0.6);
    border-color: rgba(251, 146, 60, 0.3);
  }
  
  :global(.dark) .mobile-search--open {
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(12px);
  }

  :global(.dark) .mobile-search__input {
    color: #f8fafc;
  }

  :global(.dark) .mobile-search__input::placeholder {
    color: #94a3b8;
  }

  :global(.dark) .mobile-search__toggle {
    color: #ff7a18;
  }
</style>

<script>
  document.querySelectorAll('[data-mobile-search]').forEach((form) => {
    const toggle = form.querySelector('.mobile-search__toggle');
    const input = form.querySelector('.mobile-search__input');
    const overlay = form.nextElementSibling;
    if (!toggle || !input) return;

    const setOpen = (open) => {
      if (window.innerWidth >= 1024) return; // Không làm gì trên desktop
      form.classList.toggle('mobile-search--open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) input.focus();
    };

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = form.classList.contains('mobile-search--open');
      setOpen(!isOpen);
    });

    document.addEventListener('click', (event) => {
      if (window.innerWidth < 1024 && !form.contains(event.target as Node)) {
        setOpen(false);
      }
    });

    overlay?.addEventListener('click', () => setOpen(false));

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
      }
    });
  });
</script>
