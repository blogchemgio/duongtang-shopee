---
// DuongTangGioiThieu.astro
import introImage from '../assets/duong-tang-gioi-thieu.webp';
---

<div class="bg-white dark:bg-slate-900 rounded-[32px] p-8 lg:p-10 border border-slate-200 dark:border-white/10 shadow-xl sticky top-24 font-normal">
  <div class="relative mb-6 group">
    <div class="absolute -inset-1 bg-gradient-to-r from-[#ff7a18] to-[#af43ff] rounded-[24px] blur opacity-25 group-hover:opacity-50 transition duration-1000"></div>
    <div class="relative bg-white dark:bg-slate-900 rounded-[24px] overflow-hidden border border-slate-200 dark:border-white/10">
      <img 
        src={introImage.src} 
        alt="Đường Tăng" 
        class="block w-full h-auto"
      />
    </div>
  </div>

  <div class="space-y-4 text-center">
    <h3 class="text-2xl font-normal text-slate-900 dark:text-white tracking-tighter uppercase">
      Đường Tăng<span class="text-[#ff7a18]">.vn</span>
    </h3>
    <div class="w-12 h-1 bg-[#ff7a18] mx-auto rounded-full"></div>
    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed font-normal italic text-left">
      Chào mừng thí chủ đã ghé thăm duongtang.vn!
      <br />
      Trên hành trình thỉnh kinh đầy gian nan, Tiểu Tăng cùng bốn đồ đệ đi tìm ra những sản phẩm "vừa ý, đẹp lòng" trên Shopee để chia sẻ cùng đại chúng.
      <br />
      Mỗi bài review tại đây đều được đúc kết từ tâm, giúp thí chủ chọn được món đồ tốt nhất. Nếu thấy hữu duyên và bài viết có ích, mong thí chủ hãy ủng hộ bằng cách nhấp vào liên kết để thỉnh món đồ đó về.
      <br />
      Nam mô A Di Đà Phật... Thiện tai, thiện tai! Chúc thí chủ vạn sự an lành, vạn dặm bình an!
    </p>
    
    <div class="pt-6 space-y-3">
      <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-white/5">
        <div class="w-10 h-10 rounded-xl bg-orange-500/10 flex items-center justify-center text-orange-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2v0A2.5 2.5 0 0 1 9 4.5V20H4a2 2 0 0 1-2-2V5"/><path d="M9 20h10a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-7"/><path d="M12 7h5"/><path d="M12 11h5"/><path d="M12 15h5"/></svg>
        </div>
        <div class="text-left text-xs">
          <p class="text-slate-400 font-normal uppercase tracking-widest">Chuyên mục</p>
          <p class="text-slate-900 dark:text-white font-normal text-sm">Blog Chém Gió</p>
        </div>
      </div>

      <div class="flex items-center gap-3 p-3 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-white/5">
        <div class="w-10 h-10 rounded-xl bg-purple-500/10 flex items-center justify-center text-purple-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
        </div>
        <div class="text-left text-xs">
          <p class="text-slate-400 font-normal uppercase tracking-widest">Theo dõi</p>
          <p class="text-slate-900 dark:text-white font-normal text-sm">50k+ Đồ đệ</p>
        </div>
      </div>
    </div>

    <div class="pt-6">
      <a href="/lien-he" class="block w-full py-3 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-normal rounded-2xl hover:scale-[1.02] active:scale-[0.98] transition-all">
        Kết nối ngay
      </a>
    </div>
  </div>
</div>
