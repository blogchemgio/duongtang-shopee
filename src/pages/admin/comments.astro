---
import Mainlayout from '../../layouts/Mainlayout.astro';
---

<Mainlayout title="Admin bình luận">
  <section class="admin-comments" data-admin-comments>
    <h1>Kiểm duyệt bình luận</h1>

    <div class="admin-toolbar">
      <input
        type="password"
        class="admin-token"
        data-admin-token
        placeholder="Nhập COMMENT_ADMIN_TOKEN"
      />
      <select class="admin-filter" data-admin-status>
        <option value="pending">Chờ duyệt</option>
        <option value="approved">Đã duyệt</option>
        <option value="rejected">Đã từ chối</option>
      </select>
      <button class="admin-load" data-admin-load>Tải danh sách</button>
    </div>

    <p class="admin-message" data-admin-message></p>
    <div class="admin-list" data-admin-list></div>
  </section>
</Mainlayout>

<style>
  .admin-comments {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1rem 0 2rem;
  }

  .admin-comments h1 {
    font-size: 1.6rem;
    font-weight: 900;
    margin-bottom: 1rem;
  }

  .admin-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .admin-token,
  .admin-filter {
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 0.55rem 0.7rem;
    min-width: 220px;
  }

  .admin-load {
    border: none;
    border-radius: 10px;
    background: #ff7a18;
    color: #fff;
    font-weight: 800;
    padding: 0.55rem 0.85rem;
    cursor: pointer;
  }

  .admin-message {
    color: #64748b;
    margin: 0 0 0.9rem;
  }

  .admin-list {
    display: grid;
    gap: 0.8rem;
  }

  .admin-item {
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 0.9rem;
    background: #fff;
  }

  .admin-meta {
    display: grid;
    gap: 0.25rem;
    margin-bottom: 0.6rem;
    font-size: 0.88rem;
    color: #475569;
  }

  .admin-content {
    white-space: pre-wrap;
    margin: 0 0 0.7rem;
  }

  .admin-actions {
    display: flex;
    gap: 0.55rem;
  }

  .admin-btn {
    border: none;
    border-radius: 9px;
    font-weight: 800;
    padding: 0.45rem 0.7rem;
    cursor: pointer;
  }

  .admin-btn--approve {
    background: #16a34a;
    color: #fff;
  }

  .admin-btn--reject {
    background: #ef4444;
    color: #fff;
  }
</style>

<script>
  const root = document.querySelector('[data-admin-comments]');
  if (root) {
    const tokenInput = root.querySelector('[data-admin-token]');
    const statusSelect = root.querySelector('[data-admin-status]');
    const loadBtn = root.querySelector('[data-admin-load]');
    const message = root.querySelector('[data-admin-message]');
    const list = root.querySelector('[data-admin-list]');

    const esc = (value) =>
      String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');

    const getToken = () => String(tokenInput?.value || '').trim();
    const getStatus = () => String(statusSelect?.value || 'pending');

    const headers = () => ({
      'content-type': 'application/json',
      'x-admin-token': getToken(),
    });

    const loadComments = async () => {
      if (!list || !message) return;
      if (!getToken()) {
        message.textContent = 'Nhập token trước khi tải danh sách.';
        return;
      }

      message.textContent = 'Đang tải...';
      const response = await fetch(`/api/admin/comments?status=${encodeURIComponent(getStatus())}`, {
        headers: { 'x-admin-token': getToken() },
      });

      if (!response.ok) {
        message.textContent = 'Không tải được danh sách. Kiểm tra token.';
        list.innerHTML = '';
        return;
      }

      const payload = await response.json();
      const comments = payload.comments || [];
      message.textContent = `Có ${comments.length} bình luận.`;

      if (!comments.length) {
        list.innerHTML = '<p>Không có bình luận.</p>';
        return;
      }

      list.innerHTML = comments
        .map(
          (comment) => `
            <article class="admin-item" data-comment-id="${comment.id}">
              <div class="admin-meta">
                <strong>${esc(comment.authorName)}</strong>
                <span>Bài viết: ${esc(comment.postSlug)}</span>
                <span>Thời gian: ${esc(comment.createdAt)}</span>
                <span>Trạng thái: ${esc(comment.status)}</span>
              </div>
              <p class="admin-content">${esc(comment.content)}</p>
              <div class="admin-actions">
                <button class="admin-btn admin-btn--approve" data-action="approve">Duyệt</button>
                <button class="admin-btn admin-btn--reject" data-action="reject">Từ chối</button>
              </div>
            </article>
          `
        )
        .join('');
    };

    list?.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement)) return;
      const action = target.getAttribute('data-action');
      if (!action || !['approve', 'reject'].includes(action)) return;

      const item = target.closest('[data-comment-id]');
      const id = Number(item?.getAttribute('data-comment-id'));
      if (!Number.isInteger(id)) return;

      const response = await fetch('/api/admin/comments', {
        method: 'POST',
        headers: headers(),
        body: JSON.stringify({ id, action }),
      });

      if (!response.ok) {
        if (message) message.textContent = 'Cập nhật thất bại. Kiểm tra token.';
        return;
      }

      await loadComments();
    });

    loadBtn?.addEventListener('click', loadComments);
  }
</script>
