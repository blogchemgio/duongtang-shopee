---
import Mainlayout from '../../layouts/Mainlayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';

const POSTS_PER_PAGE = 9;
const allPosts = (await getCollection('duong-tang-blog')).sort((a, b) => {
  const dateA = new Date(a.data.pubDate || Date.now()).valueOf();
  const dateB = new Date(b.data.pubDate || Date.now()).valueOf();
  return dateB - dateA;
});
const posts = allPosts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
---

<Mainlayout title="Đường Tăng.vn | Shopee">
  <section class="category-page max-w-7xl mx-auto px-6 py-12">
    <div class="mb-12">
      <h1 class="text-2xl md:text-3xl font-black text-slate-900 dark:text-white tracking-tighter uppercase mb-4 transition-colors duration-300">
        Chuyên mục <span class="text-[#ff7a18]">Đường tăng Blog</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base font-medium max-w-full leading-relaxed md:truncate">
        Nơi gom nhặt "chân kinh" mua sắm và review thực tâm trên vạn dặm đường từ Đông Thổ Đại Đường tới Đông Lào. Hữu duyên thỉnh món đồ tốt, thiện tai thiện tai!
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
      {posts.map((post) => (
        <div class="post-wrapper">
          <PostCard {...post.data} slug={`/${post.collection}/${post.id}`} collection={post.collection} />
        </div>
      ))}
    </div>
    
    {totalPages > 1 && (
      <div class="pt-8 border-t border-slate-100 dark:border-white/5 mt-12">
        <Pagination currentPage={1} totalPages={totalPages} basePath="/duong-tang-blog" />
      </div>
    )}
  </section>
</Mainlayout>

<style>
  .category-page { padding: 1rem 0 2rem; }
  .category-intro { color: #64748b; margin-bottom: 1.25rem; font-weight: 500; }
  .category-grid { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 1.25rem; }
  @media (min-width: 768px) { .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .category-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .post-wrapper { display: flex; flex-direction: column; height: 100%; }
</style>
