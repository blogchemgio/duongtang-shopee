---
import Mainlayout from '../layouts/Mainlayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';

const POSTS_PER_PAGE = 6;

// 1. Gọi dữ liệu từ tất cả 4 kho bằng Promise.all
const [blogEntries, docsEntries, pluginsEntries, themesEntries] = await Promise.all([
  getCollection('blog'),
  getCollection('docs'),
  getCollection('plugins'),
  getCollection('themes'),
]);

// 2. Gộp tất cả các bài viết lại
const allEntries = [
  ...blogEntries,
  ...docsEntries,
  ...pluginsEntries,
  ...themesEntries
];

// 3. Logic sắp xếp thông minh
const sortedEntries = allEntries
  .sort((a, b) => {
    const dateA = new Date(a.data.pubDate || Date.now()).valueOf();
    const dateB = new Date(b.data.pubDate || Date.now()).valueOf();
    return dateB - dateA;
  });

const posts = sortedEntries.slice(0, POSTS_PER_PAGE);
const totalPages = Math.ceil(sortedEntries.length / POSTS_PER_PAGE);

/** * TIÊU ĐỀ CHUẨN SEO MỚI:
 * Đầy đủ: Framework, Astro, Blog, Web, Thực hành
 * Cấu trúc: [Từ khóa chính] | [Lợi ích/Mô tả]
 */
const title = "Đường Tăng.vn Vạn Dặm Tây Thiên – Thỉnh Đồ Shopee";
---

<Mainlayout title={title}>
  <div class="w-full px-2 sm:px-4 md:px-8 lg:px-12 max-w-7xl mx-auto">
    <Hero />

    <main id="main-content">
      
      <div class="mt-2 mb-4 flex flex-col items-start"> 
        <h2 class="text-sm md:text-base font-black text-[#ff7a18] dark:text-[#ff7a18] flex items-center gap-3 uppercase tracking-tighter transition-colors duration-300"> 
          <span class="w-1.5 h-6 bg-[#ff7a18] rounded-full shadow-[0_0_10px_rgba(255,122,24,0.3)]"></span>
          "Chân kinh mới thỉnh, mua sắm tùy duyên"
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {posts.map((post) => (
          <div class="post-wrapper">
             <PostCard 
               {...post.data} 
               slug={`/${post.collection}/${post.id}`} 
               collection={post.collection} 
             />
          </div>
        ))}
      </div>

      {totalPages > 1 && (
        <Pagination currentPage={1} totalPages={totalPages} basePath="/" />
      )}
    </main>
  </div>
</Mainlayout>

<style>
  #main-content {
    will-change: transform, opacity;
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .post-wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
</style>
