---
import Mainlayout from '../layouts/Mainlayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import CategorySidebar from '../components/CategorySidebar.astro';
import { getCollection } from 'astro:content';
import { categoryMeta } from '../constants/categoryMeta';

const POSTS_PER_PAGE = 8;

// 1. Gọi dữ liệu và lọc bài viết nháp
const [blogEntries, batGioiEntries, ngoKhongTechEntries, saTangEntries] = await Promise.all([
  getCollection('blog', ({ data }) => !data.isDraft),
  getCollection('bat-gioi-review', ({ data }) => !data.isDraft),
  getCollection('ngo-khong-tech', ({ data }) => !data.isDraft),
  getCollection('sa-tang-decor', ({ data }) => !data.isDraft),
]);

// 2. Gộp tất cả (Sửa lỗi sai tên biến saTangEntries)
const allEntries = [
  ...blogEntries,
  ...batGioiEntries,
  ...ngoKhongTechEntries,
  ...saTangEntries
];

// 3. Logic sắp xếp - Đồng bộ với [page].astro
const sortedEntries = allEntries.sort((a, b) => {
  const dateA = new Date(a.data.pubDate || 0).valueOf();
  const dateB = new Date(b.data.pubDate || 0).valueOf();
  
  if (dateB !== dateA) return dateB - dateA;
  return b.id.localeCompare(a.id);
});

const posts = sortedEntries.slice(0, POSTS_PER_PAGE);
const totalPages = Math.ceil(sortedEntries.length / POSTS_PER_PAGE);

// TIÊU ĐỀ CHUẨN SEO
const title = "Review Đồ Shopee Có Tâm | Đường Tăng.vn – Vạn Dặm Thỉnh Kinh";
const description = "Hành trình thỉnh 'bảo vật' Shopee tại Đông Lào. Review chân thực, giúp thí chủ vượt qua kiếp nạn mua hàng online để thân tâm an lạc.";
---

<Mainlayout title={title} description={description}>
  <section class="home-page">
    <div class="w-full grid grid-cols-1 lg:grid-cols-[1fr_350px] gap-12 items-start">
      
      <!-- Main Content: Posts -->
      <main id="main-content">
        <div class="mb-8 flex flex-col items-start"> 
          <h2 class="text-base md:text-lg font-bold flex items-center gap-3 tracking-tight" style="color:#ff7a18;"> 
            <span class="w-1.5 h-6 bg-[#ff7a18] rounded-full shadow-[0_0_10px_rgba(255,122,24,0.5)]"></span>
            Chân kinh mới thỉnh, mua sắm tùy duyên
          </h2>
        </div>

        <div class="home-grid">
          {posts.map((post) => (
            <div class="post-wrapper">
               <PostCard 
                 {...post.data} 
                 slug={`/${post.collection}/${post.id}`} 
                 collection={categoryMeta[post.collection as keyof typeof categoryMeta]?.label || post.collection.toUpperCase()} 
               />
            </div>
          ))}
        </div>

        {totalPages > 1 && (
          <div class="mt-16 flex justify-center">
            <Pagination currentPage={1} totalPages={totalPages} basePath="/" />
          </div>
        )}
      </main>

      <!-- Sidebar: Hero Map -->
      <aside class="sticky top-28 order-2 lg:order-none mt-12 lg:mt-0">
        <CategorySidebar />
      </aside>

    </div>

    <footer class="mt-20 py-10 text-center border-t border-gray-100 dark:border-gray-800">
      <p class="italic text-gray-500 dark:text-gray-400">
        Hy vọng những chia sẻ này giúp <strong>thí chủ</strong> tìm được món đồ như ý để thân tâm thêm <strong>an lạc</strong>. <br/>
        Nếu thấy hữu ích, xin hãy lan tỏa để gieo chút duyên lành. <strong>Thiện tai! Nam mô A Di Đà Phật.</strong>
      </p>
    </footer>
  </section>
</Mainlayout>

<style>
  .home-page { padding: 0.5rem 0 2rem; }
  
  .home-grid { 
    display: grid; 
    grid-template-columns: repeat(1, minmax(0, 1fr)); 
    gap: 1.5rem; 
  }

  @media (min-width: 640px) {
    .home-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1280px) {
    .home-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  #main-content {
    will-change: transform, opacity;
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .post-wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.3s ease;
  }
  
  .post-wrapper:hover {
    transform: translateY(-5px);
  }
</style>