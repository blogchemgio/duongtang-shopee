---
import { getCollection } from 'astro:content';
import Mainlayout from '../layouts/Mainlayout.astro';
import PostCard from '../components/PostCard.astro';

export const prerender = false;

// Thỉnh dữ liệu từ các collection
const [blogEntries, batGioiEntries, ngoKhongTechEntries, satangdecorEntries] = await Promise.all([
  getCollection('blog'),
  getCollection('bat-gioi-review'),
  getCollection('ngo-khong-tech'),
  getCollection('sa-tang-decor'),
]);

const allEntries = [...blogEntries, ...batGioiEntries, ...ngoKhongTechEntries, ...satangdecorEntries];

// Hàm loại bỏ dấu tiếng Việt để tìm kiếm chính xác hơn
const removeDiacritics = (value: string) =>
  value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const normalizedQuery = removeDiacritics(query);

// FIX LỖI: Bọc các key có dấu gạch ngang trong dấu nháy đơn
const collectionLabels: Record<string, string> = {
  'blog': 'Blog',
  'bat-gioi-review': 'Bát Giới Review',
  'ngo-khong-tech': 'Ngộ Không Tech',
  'sa-tang-decor': 'Sa Tăng Decor',
};

const filteredEntries = normalizedQuery
  ? allEntries.filter((entry) => {
      const searchableValues = [
        entry.data.title,
        entry.data.description,
        entry.id,
        ...(Array.isArray(entry.data.tags) ? entry.data.tags : []),
      ]
        .filter(Boolean)
        .join(' ')
        .toString();

      return removeDiacritics(searchableValues).includes(normalizedQuery);
    })
  : [];

// Sắp xếp bài viết theo ngày mới nhất
const posts = filteredEntries.sort((a, b) => {
  const dateA = new Date(a.data.pubDate || Date.now()).valueOf();
  const dateB = new Date(b.data.pubDate || Date.now()).valueOf();
  return dateB - dateA;
});
---

<Mainlayout title="Tìm kiếm | Đường Tăng.vn">
  <section class="search-page px-4 md:px-0">
    <div class="mb-8">
      <h1 class="search-title">Kết quả tìm kiếm</h1>

      {query ? (
        <p class="search-meta">
          A đây rồi! Đã tìm thấy <strong class="text-[#ff7a18]">{posts.length}</strong> kết quả cho: <strong>"{query}"</strong>
        </p>
      ) : (
        <p class="search-meta">Nhập từ khóa thỉnh kinh để bắt đầu tìm kiếm.</p>
      )}
    </div>

    {posts.length > 0 && (
      <div class="search-grid">
        {posts.map((post) => (
          <PostCard
            {...post.data}
            slug={`/${post.collection}/${post.id}`}
            collection={collectionLabels[post.collection as keyof typeof collectionLabels] || post.collection}
          />
        ))}
      </div>
    )}

    {query && posts.length === 0 && (
      <div class="search-empty glass-effect">
        <p>Xin lỗi thí chủ, tiểu tăng không tìm thấy bài phù hợp.</p>
        <p class="text-sm mt-2">Thử thỉnh từ khóa ngắn hơn hoặc dùng không dấu.</p>
      </div>
    )}

    <button type="button" id="search-jump-btn" class="search-jump-btn" aria-label="Sửa từ khóa tìm kiếm">
      Sửa từ khóa
    </button>
  </section>
</Mainlayout>

<style>
  .search-page {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  .search-title {
    font-size: 2rem;
    font-weight: 900;
    color: #0f172a;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    tracking-tighter;
  }

  :global(.is-dark) .search-title {
    color: #ffffff;
  }

  .search-meta {
    color: #64748b;
    font-size: 1rem;
    font-style: italic;
  }

  .search-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .search-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .search-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .search-empty {
    border: 2px dashed #e2e8f0;
    border-radius: 24px;
    padding: 3rem 1rem;
    color: #64748b;
    text-align: center;
    font-weight: 600;
  }

  :global(.is-dark) .search-empty {
    border-color: rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.02);
  }

  .search-jump-btn {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    border: none;
    border-radius: 999px;
    background: #ff7a18;
    color: #ffffff;
    font-weight: 800;
    font-size: 0.9rem;
    padding: 0.8rem 1.2rem;
    box-shadow: 0 10px 25px rgba(255, 122, 24, 0.4);
    z-index: 90;
    opacity: 0;
    pointer-events: none;
    transform: translateY(20px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .search-jump-btn.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  @media (min-width: 1024px) {
    .search-jump-btn {
      display: none;
    }
  }
</style>

<script>
  const jumpBtn = document.getElementById('search-jump-btn');
  const isMobile = () => window.matchMedia('(max-width: 1023px)').matches;

  const focusHeaderSearch = () => {
    const input = document.getElementById('header-search-input') as HTMLInputElement;
    if (!input) return;

    // Cuộn lên đầu trang mượt mà
    window.scrollTo({ top: 0, behavior: 'smooth' });
    
    setTimeout(() => {
      input.focus();
      // Chọn toàn bộ text để thí chủ dễ sửa
      input.select();
    }, 300);
  };

  const updateButtonState = () => {
    if (!jumpBtn) return;
    const show = isMobile() && window.scrollY > 300;
    jumpBtn.classList.toggle('is-visible', show);
  };

  jumpBtn?.addEventListener('click', focusHeaderSearch);
  window.addEventListener('scroll', updateButtonState, { passive: true });
  window.addEventListener('resize', updateButtonState);
  updateButtonState();
</script>