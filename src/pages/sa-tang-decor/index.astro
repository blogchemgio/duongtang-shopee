---
import { getCollection } from 'astro:content';
import Mainlayout from '../../layouts/Mainlayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { categoryMeta } from '../../constants/categoryMeta';

const currentCategory = 'sa-tang-decor';
const meta = categoryMeta[currentCategory];

const POSTS_PER_PAGE = 8;

// HÓA GIẢI: Đổi 'themes' thành 'sa-tang-decor'
const allPosts = (await getCollection('sa-tang-decor', ({ data }) => !data.isDraft)).sort((a, b) => {
  const dateA = new Date(a.data.pubDate || 0).valueOf();
  const dateB = new Date(b.data.pubDate || 0).valueOf();
  
  if (dateB !== dateA) return dateB - dateA;
  return b.id.localeCompare(a.id);
});

const posts = allPosts.slice(0, POSTS_PER_PAGE);
const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
---

<Mainlayout 
  title={`${meta.heading} | Lối Sống & Trang Trí | Đường Tăng.vn`}
  description={meta.intro}
>
  <section class="category-page">
    <div class="category-hero">
      <h1>{meta.heading}</h1>
      <p class="category-intro">
        {meta.intro}
      </p>
    </div>

    <div class="category-grid">
      {posts.map((post, index) => (
        <PostCard 
          {...post.data} 
          slug={`/${currentCategory}/${post.id}`} 
          collection={meta.label} 
          loading={index === 0 ? "eager" : "lazy"} 
          fetchpriority={index === 0 ? "high" : "auto"}
        />
      ))}
    </div>

    {totalPages > 1 && (
      <div class="mt-12">
        <Pagination currentPage={1} totalPages={totalPages} basePath={`/${currentCategory}`} />
      </div>
    )}
  </section>
</Mainlayout>

<style>
  .category-page { padding: 1.5rem 0 3rem; }
  .category-hero { margin-bottom: 2.5rem; border-bottom: 1px solid rgba(0,0,0,0.05); padding-bottom: 1.5rem; }
  :global(.is-dark) .category-hero { border-bottom-color: rgba(255,255,255,0.05); }
  
  .category-intro { color: #64748b; margin-bottom: 0; font-weight: 500; max-width: 800px; line-height: 1.6; }
  .category-grid { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 1.5rem; }
  
  @media (min-width: 640px) { .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { 
    .category-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } 
    .category-hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; }
    .category-hero h1 { margin-bottom: 0 !important; }
    .category-intro { text-align: right; max-width: 500px; }
  }
</style>