---
import Mainlayout from '../layouts/Mainlayout.astro';
import { Image } from 'astro:assets';
// Đảm bảo đường dẫn ảnh này chính xác trong thư mục src/assets/ của bạn
import myProfileImage from '../assets/4.webp';

const pageTitle = "Giới thiệu | duongtang.vn";
const description = "Hành trình từ Đông Thổ Đại Đường tới Đông Lào thỉnh kinh, chuyên review đồ Shopee, công nghệ và lối sống.";
---

<Mainlayout title={pageTitle} description={description} type="profile">
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "mainEntity": {
        "@type": "Person",
        "name": "Admin duongtang.vn",
        "url": "https://duongtang.vn/gioi-thieu",
        "description": "Tác giả chuyển đổi từ nền tảng Blogger sang Astro, chuyên review đa lĩnh vực.",
        "knowsAbout": [
          "Consumer Electronics", 
          "Lifestyle and Wellness", 
          "Culinary Arts and Food Reviews", 
          "E-commerce", 
          "Astro Framework", 
          "Web Development"
        ],
        "hasOccupation": {
          "@type": "Occupation",
          "name": "Content Creator & Affiliate Marketer"
        },
        "image": "https://duongtang.vn/4.webp"
      }
    }
  </script>

  <main class="max-w-3xl mx-auto px-6 py-12">
    <article class="prose prose-slate prose-lg md:prose-xl dark:prose-invert max-w-none">
      
      <div class="mb-10 overflow-hidden rounded-3xl shadow-2xl border border-slate-200 dark:border-slate-800">
        <Image 
          src={myProfileImage} 
          alt="Hành trình thỉnh kinh tại duongtang.vn"
          width={800}
          height={450}
          loading="eager" 
          fetchpriority="high"
          class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700"
        />
        <figcaption class="text-center text-sm text-slate-500 dark:text-slate-400 py-3 bg-slate-50 dark:bg-slate-900/50 italic border-t border-slate-100 dark:border-slate-800">
          Hành trình 4 tiểu yêu núi Lãng Lãng từ Đông Thổ Đại Đường tới Đông Lào thỉnh kinh
        </figcaption>
      </div>

      <h1 class="text-3xl md:text-4xl font-black mb-8 text-slate-900 dark:text-white leading-tight tracking-tighter uppercase">
        Chào mừng thí chủ đến với <span class="text-orange-500">Đường Tăng.vn</span>
      </h1>

      <div class="space-y-6 text-lg leading-relaxed text-slate-700 dark:text-slate-300 antialiased">
        <p>
          Trang web này là nơi hội ngộ của những tâm hồn yêu công nghệ và thích săn deal mã giảm giá, lấy cảm hứng từ câu chuyện về các tiểu yêu núi Lãng Lãng — những kẻ nhỏ bé nhưng đầy nhiệt huyết với giấc mơ lớn.
        </p>
        <p>
          Cuộc hành trình từ Đông Thổ Đại Đường tới Đông Lào không chỉ là để thỉnh chân kinh, mà còn là hành trình thỉnh những món đồ Shopee "ngon - bổ - rẻ" để chia sẻ cùng thí chủ.
        </p>
        <p>
          Tại đây, mỗi bài viết review giúp thí chủ tránh xa hàng kém chất lượng và tìm được bảo vật thực sự cho cuộc sống đời thường.
        </p>
        <p>
          Từ những món đồ decor của Sa Tăng, công nghệ của Ngộ Không cho đến những món ăn ngon của Bát Giới, tất cả đều được chọn lọc bằng cái tâm của người làm nghề.
        </p>
        
        <div class="p-6 bg-orange-50 dark:bg-orange-950/20 rounded-2xl border-l-4 border-orange-500 my-8">
          <p class="text-slate-800 dark:text-slate-200 font-medium italic">
            "Đường tăng.vn là một blog tiếp thị liên kết. Khi thí chủ đọc các bài viết giới thiệu sản phẩm và click vào nút mua hàng, hệ thống sẽ chuyển hướng thí chủ sang trang Shopee. Hữu duyên tại nơi ấy thí chủ chọn được một món đồ ưng ý, tiểu tăng sẽ được nhận một khoản hoa hồng nhỏ để duy trì kinh phí thỉnh kinh. Vạn sự tùy duyên, chúc thí chủ thỉnh về được những món đồ tốt lành nhất. Thiện tai!"
          </p>
        </div>

        <p>
          Đường tăng tin rằng, việc mua sắm cũng là một cái duyên, và việc chọn đúng món đồ tốt chính là một loại hạnh phúc đơn sơ giữa bộn bề cuộc sống.
        </p>
        <p>
          Dù thí chủ là một người đang tìm cảm hứng viết lách hoặc là một người nội trợ đang săn sale, hy vọng nơi đây đều có thể gieo chút duyên lành và gửi quả ngọt đến bạn.
        </p>
        <p>
          Hành trình vạn dặm khởi đầu từ một bước chân, và bước chân của thí chủ ghé thăm nơi đây chính là niềm khích lệ lớn lao nhất cho tiểu tăng trên con đường phát triển blog.
        </p>
        <p class="font-bold text-orange-500 italic pt-4 border-t border-dashed border-slate-200 dark:border-slate-800 text-center">
          Cảm ơn thí chủ đã dành thời gian ghé thăm. Mua sắm tùy duyên, chúc thí chủ thân tâm luôn an lạc và vạn sự hanh thông. Nam mô A Di Đà Phật!
        </p>
      </div>

      <div class="mt-16 flex justify-center">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold px-10 py-4 rounded-2xl transition-all hover:bg-orange-500 dark:hover:bg-orange-500 dark:hover:text-white shadow-xl hover:-translate-y-1"
        >
          <span>Quay lại trang chủ</span>
        </a>
      </div>
    </article>
  </main>
</Mainlayout>

<style>
  main {
    animation: fadeIn 0.8s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>