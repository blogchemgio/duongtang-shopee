---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Mainlayout from '../../layouts/Mainlayout.astro';
import TableOfContents from '../../components/TableOfContents';
import TocMobileFab from '../../components/TocMobileFab';
import Comments from '../../components/Comments.astro';
import RelatedPostsCarousel from '../../components/RelatedPostsCarousel.astro';
import { categoryMeta } from '../../constants/categoryMeta';

// 1. Lấy tất cả paths từ 4 chuyên mục
export async function getStaticPaths() {
  const categories = ['blog', 'bat-gioi-review', 'ngo-khong-tech', 'sa-tang-decor'];
  const allPaths = [];

  for (const cat of categories) {
    const entries = await getCollection(cat as any);
    allPaths.push(...entries.map(entry => ({
      params: { collection: cat, slug: entry.id },
      props: { entry, category: cat },
    })));
  }
  return allPaths;
}

const { entry, category } = Astro.props;
const { Content, headings } = await render(entry);
const postSlug = `${category}/${entry.id}`;

const baseCategories = [ 
   { name: "Thời Trang Nam", link: "https://shorten.asia/X4mqK3As" }, 
   { name: "Phụ Kiện Điện Thoại", link: "https://shorten.asia/tfrPBrqR" }, 
   { name: "Thiết Bị Điện Tử", link: "https://shorten.asia/JcAAWTmd" }, 
   { name: "Máy Tính & Laptop", link: "https://shorten.asia/F7ss9yPt" }, 
   { name: "Máy Ảnh & Quay Phim", link: "https://shorten.asia/bZUQHjY8" }, 
   { name: "Đồng Hồ", link: "https://shorten.asia/udrmQNzJ" }, 
   { name: "Giày Dép Nam", link: "https://shorten.asia/5fgvuSBN" }, 
   { name: "Thiết Bị Gia Dụng", link: "https://shorten.asia/XCaPG72W" }, 
   { name: "Thể Thao & Du Lịch", link: "https://shorten.asia/9YXxb1Fc" }, 
   { name: "Xe Máy & Xe Đạp", link: "https://shorten.asia/7EkAXQNN" }, 
   { name: "Balo, Túi & Ví", link: "https://shorten.asia/GYgQ5VbF" }, 
   { name: "Đồ Chơi", link: "https://shorten.asia/Kk226puw" }, 
   { name: "Thời Trang Nữ", link: "https://shorten.asia/PyWzCwRe" }, 
   { name: "Mẹ & Bé", link: "https://shorten.asia/52CTWnh1" }, 
   { name: "Nhà Cửa & Đời Sống", link: "https://shorten.asia/qB9Gb3dN" }, 
   { name: "Sắc Đẹp", link: "https://shorten.asia/yx1uuvrn" }, 
   { name: "Sức Khỏe", link: "https://shorten.asia/xEDxKRJ1" }, 
   { name: "Giày Dép Nữ", link: "https://shorten.asia/G1yXwHze" }, 
   { name: "Túi Ví Nữ", link: "https://shorten.asia/ERbsJ3Qs" }, 
   { name: "Phụ Kiện & Trang Sức", link: "https://shorten.asia/Dbt647df" }, 
   { name: "Bách Hóa Online", link: "https://shorten.asia/UQEaqDt3" }, 
   { name: "Nhà Sách Online", link: "https://shorten.asia/NXgrWJW4" }, 
   { name: "Thời Trang Trẻ Em", link: "https://shorten.asia/txcnexCa" }, 
   { name: "Chăm Sóc Thú Cưng", link: "https://shorten.asia/Hwx2zkv4" }, 
   { name: "Dịch Vụ Thiết Bị", link: "https://shorten.asia/QfyKbkYe" }, 
   { name: "Giặt Giũ & Nhà Cửa", link: "https://shorten.asia/mKUydBhq" }, 
   { name: "Voucher & Dịch Vụ", link: "https://shorten.asia/4qrhuBkn" } 
]; 
const categoriesData = baseCategories.sort(() => Math.random() - 0.5); 

const categoriesList = ['blog', 'bat-gioi-review', 'ngo-khong-tech', 'sa-tang-decor'] as const;
const allEntries = (await Promise.all(categoriesList.map((name) => getCollection(name)))).flat();
const currentTags = Array.isArray(entry.data.tags) ? entry.data.tags : [];

const relatedPosts = allEntries
  .filter((item) => !(item.collection === entry.collection && item.id === entry.id))
  .map((item) => {
    const tags = Array.isArray(item.data.tags) ? item.data.tags : [];
    const sharedTags = tags.filter((tag) => currentTags.includes(tag)).length;
    const sameCollection = item.collection === entry.collection ? 1 : 0;
    const score = sharedTags * 5 + sameCollection * 3;
    return { item, score };
  })
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    const dateA = new Date(a.item.data.pubDate || 0).valueOf();
    const dateB = new Date(b.item.data.pubDate || 0).valueOf();
    return dateB - dateA;
  })
  .slice(0, 3)
  .map(({ item }) => {
    const meta = categoryMeta[item.collection as keyof typeof categoryMeta];
    return {
      title: item.data.title,
      slug: `/${item.collection}/${item.id}`,
      image: item.data.image,
      collection: item.data.category || meta?.label || item.collection.toUpperCase(),
    };
  });

const postTags = Array.isArray(entry.data.tags) ? entry.data.tags : [];

// Format ngày tháng an toàn
const displayDate = entry.data.pubDate
  ? new Date(entry.data.pubDate).toLocaleDateString('vi-VN')
  : 'Tài nguyên';

const meta = categoryMeta[category as keyof typeof categoryMeta];
const badgeLabel = entry.data.category || meta?.label || category.toUpperCase();
---

<Mainlayout 
  title={entry.data.title} 
  description={entry.data.description}
  ogImage={typeof entry.data.image === 'string' ? entry.data.image : entry.data.image?.src}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": entry.data.title,
    "description": entry.data.description,
    "image": typeof entry.data.image === 'string' ? entry.data.image : entry.data.image?.src,
    "datePublished": entry.data.pubDate?.toISOString(),
    "dateModified": entry.data.updatedDate?.toISOString() || entry.data.pubDate?.toISOString(),
    "author": {
      "@type": "Person",
      "name": entry.data.author || "Đường Tăng",
      "url": "https://duongtang.vn"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Đường Tăng.vn",
      "logo": {
        "@type": "ImageObject",
        "url": "https://duongtang.vn/default-og.webp"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://duongtang.vn/${category}/${entry.id}`
    }
  })} />
  {headings.length > 0 && <TocMobileFab headings={headings} client:idle />}

  <div class="w-full px-2 md:px-10 lg:px-16 py-4 grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-12">
    
    <article class="max-w-[1000px] ml-0 pt-2 pb-12 text-left">
      <header class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <span class="px-3 py-1 bg-[#ff7a18]/10 text-[#ff7a18] text-[10px] font-black uppercase rounded-full border border-[#ff7a18]/20 shadow-sm">
              {badgeLabel}
          </span>
          <span class="text-slate-500 text-[11px] font-bold tracking-tight italic">
            {displayDate}
          </span>
        </div>

        <h1 class="text-3xl md:text-5xl font-black text-slate-900 dark:text-white leading-[1.1] mb-8 tracking-tighter">
          {entry.data.title}
        </h1>

        {entry.data.image && (
          <div class="relative group">
             <Image 
               src={entry.data.image} 
               alt={entry.data.title} 
               width={1000}
               height={550}
               format="webp"
               loading="eager"
               class="w-full h-auto rounded-[32px] shadow-2xl border border-white/10 object-cover max-h-[550px] transition-transform duration-700 group-hover:scale-[1.01]" 
             />
             <div class="absolute inset-0 rounded-[32px] shadow-[inset_0_0_40px_rgba(0,0,0,0.1)] pointer-events-none"></div>
          </div>
        )}
      </header>

      <div class="prose prose-orange prose-lg md:prose-xl max-w-none mt-10 dark:prose-invert
                  prose-headings:font-black prose-headings:tracking-tighter
                  prose-p:leading-relaxed prose-p:text-slate-700 dark:prose-p:text-slate-300
                  prose-img:rounded-3xl prose-img:shadow-lg">
        {headings.length > 0 && (
          <div class="mb-10 lg:block">
            <TableOfContents headings={headings} client:idle />
          </div>
        )}
        <Content />
      </div>

      <Comments postSlug={postSlug} />

      <section class="article-share" aria-label="Chia sẻ bài viết">
        {postTags.length > 0 && (
          <div class="article-tags mb-6">
            <p class="article-tags__title text-lg font-black mb-3 tracking-tight">Tag bài viết</p>
            <div class="article-tags__list flex flex-wrap gap-2">
              {postTags.map((tag) => (
                <a class="article-tags__item" href={`/tim-kiem?q=${encodeURIComponent(tag)}`}>
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="article-share__header flex items-center justify-between mb-4 pt-6 border-t border-slate-200 dark:border-white/10">
          <p class="article-share__title text-lg font-black tracking-tight m-0">Chia sẻ bài viết</p>
        </div>
        
        <div class="article-share__buttons">
          <button type="button" class="article-share__btn" data-share="facebook">Facebook</button>
          <button type="button" class="article-share__btn" data-share="x">X</button>
          <button type="button" class="article-share__btn" data-share="zalo">Zalo</button>
          <button type="button" class="article-share__btn" data-share="copy">Copy link</button>
        </div>
      </section>

      <RelatedPostsCarousel title="Có Thể Thí Chủ Sẽ Thích" items={relatedPosts} />
    </article>

    <aside class="hidden lg:block relative">
      <div class="sticky top-28">
        <div class="shopee-categories-sidebar">
          <div class="flex items-center gap-2 mb-4 px-1"> 
            <span class="relative flex h-2 w-2"> 
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span> 
                <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span> 
            </span> 
            <span class="text-[10px] font-black text-slate-900 dark:text-[#ff7a18] uppercase tracking-widest">Deal mới mỗi ngày</span> 
          </div>

          <div class="flex flex-wrap gap-2"> 
            {categoriesData.map((cat) => ( 
              <a 
                href={cat.link} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="px-3 py-1.5 bg-[#efe7d2] dark:bg-white/5 border border-black/5 dark:border-white/10 rounded-full text-[11px] font-bold text-slate-600 dark:text-slate-300 hover:bg-[#EB6658] hover:text-white dark:hover:bg-[#EB6658] dark:hover:text-white transition-all active:scale-95 whitespace-nowrap shadow-sm" 
              > 
                {cat.name} 
              </a> 
            ))} 
          </div>
        </div>

        <div class="mt-8 p-6 rounded-[24px] bg-slate-950 text-white dark:bg-[#ff7a18]/10 dark:text-white border border-white/10">
          <p class="text-[10px] font-black uppercase tracking-widest text-[#ff7a18] mb-2">⚡ Info</p>
          <p class="text-xs font-medium opacity-80 leading-relaxed">
            Hy vọng những chia sẻ này giúp thí chủ tìm được món đồ như ý để thân tâm thêm an lạc. Nếu thấy hữu ích, xin hãy chia sẻ để gieo chút duyên lành đến mọi người. Thiện tai, thiện tai! Nam mô A Di Đà Phật.
          </p>
        </div>
      </div>
    </aside>

  </div>
</Mainlayout>

<style>
  .article-share {
    margin-top: 1.6rem;
    padding: 1rem 0 0.4rem;
    border-top: 1px solid rgba(148, 163, 184, 0.25);
  }

  .article-share__title,
  .article-tags__title {
    margin: 0 0 0.55rem;
    font-size: 0.95rem;
    font-weight: 900;
    color: #0f172a;
  }

  .article-share__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .article-share__btn {
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    background: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    color: #334155;
    cursor: pointer;
  }

  .article-tags {
    margin-top: 0.8rem;
  }

  .article-tags__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .article-tags__item {
    text-decoration: none;
    border: 1px solid #fed7aa;
    background: #fff7ed;
    color: #c2410c;
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
    font-size: 0.78rem;
    font-weight: 700;
  }

  :global(.is-dark) .article-share__title,
  :global(.is-dark) .article-tags__title {
    color: #f8fafc;
  }

  :global(.is-dark) .article-share__btn {
    background: rgba(15, 23, 42, 0.7);
    border-color: rgba(148, 163, 184, 0.35);
    color: #cbd5e1;
  }

  :global(.is-dark) .article-tags__item {
    background: rgba(255, 122, 24, 0.14);
    border-color: rgba(255, 122, 24, 0.3);
    color: #fdba74;
  }
</style>

<script>
  const shareRoot = document.querySelector('.article-share');
  if (shareRoot) {
    const makeUrl = () => window.location.href;
    const makeText = () => document.title;

    shareRoot.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement)) return;
      const type = target.getAttribute('data-share');
      if (!type) return;

      const url = encodeURIComponent(makeUrl());
      const text = encodeURIComponent(makeText());

      if (type === 'facebook') {
        window.open(`https://www.facebook.com/sharer/sharer.php?u=${url}`, '_blank', 'noopener,noreferrer');
        return;
      }
      if (type === 'x') {
        window.open(`https://twitter.com/intent/tweet?url=${url}&text=${text}`, '_blank', 'noopener,noreferrer');
        return;
      }
      if (type === 'zalo') {
        window.open(`https://zalo.me/share?url=${url}`, '_blank', 'noopener,noreferrer');
        return;
      }
      if (type === 'copy') {
        try {
          await navigator.clipboard.writeText(makeUrl());
          target.textContent = 'Da copy';
          setTimeout(() => {
            target.textContent = 'Copy link';
          }, 1500);
        } catch {
          // Ignore clipboard errors silently.
        }
      }
    });
  }
</script>
