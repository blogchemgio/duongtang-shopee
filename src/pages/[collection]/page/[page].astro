---
import { getCollection } from 'astro:content';
import Mainlayout from '../../../layouts/Mainlayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';

type CategoryKey = 'blog' | 'docs' | 'plugins' | 'themes';

const categoryMeta: Record<CategoryKey, { heading: string; intro: string; label: string }> = {
  blog: {
    heading: 'Chuyên mục Blog',
    intro: 'Đây là chuyên mục Blog. Chức năng của mục này là chia sẻ bài viết thực chiến, kinh nghiệm và góc nhìn công nghệ.',
    label: 'BLOG',
  },
  docs: {
    heading: 'Chuyên mục Tài liệu',
    intro: 'Đây là chuyên mục Tài liệu. Chức năng của mục này là tổng hợp hướng dẫn, quy trình và ghi chú để tra cứu nhanh.',
    label: 'DOCS',
  },
  plugins: {
    heading: 'Chuyên mục Plugins',
    intro: 'Đây là chuyên mục Plugins. Chức năng của mục này là giới thiệu công cụ, plugin hữu ích và cách tích hợp thực tế.',
    label: 'PLUGINS',
  },
  themes: {
    heading: 'Chuyên mục Themes',
    intro: 'Đây là chuyên mục Themes. Chức năng của mục này là trình bày giao diện mẫu, ý tưởng thiết kế và bộ khung để tái sử dụng.',
    label: 'THEMES',
  },
};

export async function getStaticPaths({ paginate }) {
  const paths = [];
  const POSTS_PER_PAGE = 6;
  const categories: CategoryKey[] = ['blog', 'docs', 'plugins', 'themes'];

  for (const category of categories) {
    const entries = (await getCollection(category)).sort((a, b) => {
      const dateA = new Date(a.data.pubDate || Date.now()).valueOf();
      const dateB = new Date(b.data.pubDate || Date.now()).valueOf();
      return dateB - dateA;
    });

    const paginated = paginate(entries, {
      params: { collection: category },
      pageSize: POSTS_PER_PAGE,
      props: {
        category,
      },
    });

    paths.push(...paginated);
  }

  return paths;
}

const { category, page } = Astro.props;
const currentCollection = category as CategoryKey;
const meta = categoryMeta[currentCollection];
---

<Mainlayout title={`${meta.heading} | Blog Chém Gió`}>
  <section class="category-page">
    <h1>{meta.heading}</h1>
    <p class="category-intro">{meta.intro}</p>

    <div class="category-grid">
      {page.data.map((post) => (
        <PostCard {...post.data} slug={`/${currentCollection}/${post.id}`} collection={meta.label} />
      ))}
    </div>

    <Pagination currentPage={page.currentPage} totalPages={page.lastPage} basePath={`/${currentCollection}`} />
  </section>
</Mainlayout>

<style>
  .category-page { padding: 1rem 0 2rem; }
  .category-intro { color: #64748b; margin-bottom: 1.25rem; font-weight: 500; }
  .category-grid { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 1.25rem; }
  @media (min-width: 768px) { .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .category-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
