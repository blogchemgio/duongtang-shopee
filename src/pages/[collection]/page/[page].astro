---
import { getCollection } from 'astro:content';
import Mainlayout from '../../../layouts/Mainlayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';

type CategoryKey = 'blog' | 'bat-gioi-review' | 'ngo-khong-tech' | 'sa-tang-decor';

const categoryMeta: Record<CategoryKey, { heading: string; intro: string; label: string }> = {
  blog: {
    heading: 'Chuyên mục Blog',
    intro: 'Đây là chuyên mục đường tăng review 81 kiếp nạn mua đồ trên shopee.',
    label: 'BLOG',
  },
  'bat-gioi-review': {
    heading: 'Chuyên mục Bát Giới Review',
    intro: 'Đây là chuyên mục Bát Giới Review đồ ăn ngon.',
    label: 'BÁT GIỚI',
  },
  'ngo-khong-tech': {
    heading: 'Chuyên mục Ngộ Không Tech',
    intro: 'Đây là chuyên mục Ngộ Không Tech. Chuyên chia sẻ về phép thuật và giải pháp công nghệ.',
    label: 'NGỘ KHÔNG',
  },
  themes: {
    heading: 'Chuyên mục Sa Tăng decor',
    intro: 'Nếu mà mệt quá thì về quê ta cùng nuôi cá và trồng thêm rau',
    label: 'SA TĂNG',
  },
};

export async function getStaticPaths({ paginate }) {
  const paths = [];
  const POSTS_PER_PAGE = 6;
  const categories: CategoryKey[] = ['blog', 'bat-gioi-review', 'ngo-khong-tech', 'sa-tang-decor'];

  for (const category of categories) {
    const entries = (await getCollection(category)).sort((a, b) => {
      const dateA = new Date(a.data.pubDate || Date.now()).valueOf();
      const dateB = new Date(b.data.pubDate || Date.now()).valueOf();
      return dateB - dateA;
    });

    const paginated = paginate(entries, {
      params: { collection: category },
      pageSize: POSTS_PER_PAGE,
      props: {
        category,
      },
    });

    paths.push(...paginated);
  }

  return paths;
}

const { category, page } = Astro.props;
const currentCollection = category as CategoryKey;
const meta = categoryMeta[currentCollection];
---

<Mainlayout title={`${meta.heading} | ĐƯỜNG TĂNG.VN`}>
  <section class="category-page">
    <h1>{meta.heading}</h1>
    <p class="category-intro">{meta.intro}</p>

    <div class="category-grid">
      {page.data.map((post) => (
        <PostCard {...post.data} slug={`/${currentCollection}/${post.id}`} collection={meta.label} />
      ))}
    </div>

    <Pagination currentPage={page.currentPage} totalPages={page.lastPage} basePath={`/${currentCollection}`} />
  </section>
</Mainlayout>

<style>
  .category-page { padding: 1rem 0 2rem; }
  .category-intro { color: #64748b; margin-bottom: 1.25rem; font-weight: 500; }
  .category-grid { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 1.25rem; }
  @media (min-width: 768px) { .category-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .category-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
