---
import { getCollection } from 'astro:content';
import Mainlayout from '../../../layouts/Mainlayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';

type CategoryKey = 'duong-tang-blog' | 'bat-gioi-review' | 'plugins' | 'themes';

const categoryMeta: Record<CategoryKey, { heading: string; intro: string; label: string }> = {
  'duong-tang-blog': {
    heading: 'Chuyên mục Đường Tăng blog',
    intro: 'Nơi gom nhặt "chân kinh" mua sắm và review thực tâm trên vạn dặm đường từ Đông Thổ Đại Đường tới Đông Lào. Hữu duyên thỉnh món đồ tốt, thiện tai thiện tai!',
    label: 'BLOG',
  },
  'bat-gioi-review': {
    heading: 'Chuyên mục Tài liệu',
    intro: 'Đây là chuyên mục Tài liệu. Chức năng của mục này là tổng hợp hướng dẫn, quy trình và ghi chú để tra cứu nhanh.',
    label: 'DOCS',
  },
  plugins: {
    heading: 'Chuyên mục Plugins',
    intro: 'Đây là chuyên mục Plugins. Chức năng của mục này là giới thiệu công cụ, plugin hữu ích và cách tích hợp thực tế.',
    label: 'PLUGINS',
  },
  themes: {
    heading: 'Chuyên mục Themes',
    intro: 'Đây là chuyên mục Themes. Chức năng của mục này là trình bày giao diện mẫu, ý tưởng thiết kế và bộ khung để tái sử dụng.',
    label: 'THEMES',
  },
};

export async function getStaticPaths({ paginate }) {
  const paths = [];
  const categories: CategoryKey[] = ['duong-tang-blog', 'bat-gioi-review', 'plugins', 'themes'];

  for (const category of categories) {
    const POSTS_PER_PAGE = category === 'duong-tang-blog' ? 9 : 6;
    const entries = (await getCollection(category)).sort((a, b) => {
      const dateA = new Date(a.data.pubDate || Date.now()).valueOf();
      const dateB = new Date(b.data.pubDate || Date.now()).valueOf();
      return dateB - dateA;
    });

    const paginated = paginate(entries, {
      params: { collection: category },
      pageSize: POSTS_PER_PAGE,
      props: {
        category,
      },
    });

    paths.push(...paginated);
  }

  return paths;
}

const { category, page } = Astro.props;
const currentCollection = category as CategoryKey;
const meta = categoryMeta[currentCollection];
const isDuongTangBlog = currentCollection === 'duong-tang-blog';
---

<Mainlayout title={`${meta.heading} - Trang ${page.currentPage} | Blog Chém Gió`}>
  <section class="category-page max-w-7xl mx-auto px-6 py-12">
    <div class="mb-12">
      <h1 class={isDuongTangBlog ? "text-2xl md:text-3xl font-black text-slate-900 dark:text-white tracking-tighter uppercase mb-4 transition-colors duration-300" : "text-4xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tighter uppercase mb-4 transition-colors duration-300"}>
        {meta.heading}
      </h1>
      <p class={isDuongTangBlog ? "text-slate-600 dark:text-slate-400 text-sm md:text-base font-medium max-w-full leading-relaxed md:truncate" : "text-slate-600 dark:text-slate-400 text-lg font-medium max-w-2xl leading-relaxed"}>
        {meta.intro}
      </p>
    </div>

    <div class="space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {page.data.map((post) => (
          <div class="post-wrapper">
            <PostCard {...post.data} slug={`/${currentCollection}/${post.id}`} collection={post.collection} />
          </div>
        ))}
      </div>
      
      {page.lastPage > 1 && (
        <div class="pt-8 border-t border-slate-100 dark:border-white/5">
          <Pagination currentPage={page.currentPage} totalPages={page.lastPage} basePath={`/${currentCollection}`} />
        </div>
      )}
    </div>
  </section>
</Mainlayout>

<style>
  .post-wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
</style>
