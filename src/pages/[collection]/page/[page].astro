---
import { getCollection } from 'astro:content';
import Mainlayout from '../../../layouts/Mainlayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { categoryMeta, type CategoryKey } from '../../../constants/categoryMeta';

export async function getStaticPaths({ paginate }) {
  const categories: CategoryKey[] = ['blog', 'bat-gioi-review', 'ngo-khong-tech', 'sa-tang-decor'];
  const allPaths = [];
  const POSTS_PER_PAGE = 6;

  for (const category of categories) {
    const entries = await getCollection(category as any);
    // Sắp xếp bài mới nhất lên đầu - Đảm bảo đồng bộ và ổn định
    entries.sort((a, b) => {
      const dateA = new Date(a.data.pubDate || 0).valueOf();
      const dateB = new Date(b.data.pubDate || 0).valueOf();
      
      if (dateB !== dateA) return dateB - dateA;
      return b.id.localeCompare(a.id);
    });

    const paginated = paginate(entries, {
      params: { collection: category },
      pageSize: POSTS_PER_PAGE,
      props: { categoryMeta: categoryMeta[category] }, 
    });
    
    allPaths.push(...paginated.slice(1));
  }
  return allPaths;
}

const { page, categoryMeta: meta } = Astro.props;
const { collection } = Astro.params;
---

<Mainlayout title={`${meta.heading} - Trang ${page.currentPage} | Đường Tăng.vn`}>
  <section class="max-w-7xl mx-auto px-4 py-8">
    <h1 class="text-4xl font-black mb-2">{meta.heading}</h1>
    <p class="text-slate-500 mb-8 font-medium">{meta.intro}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {page.data.map((post) => (
        <PostCard 
          {...post.data} 
          slug={`/${post.collection}/${post.id}`} 
          collection={meta.label} 
        />
      ))}
    </div>

    <div class="mt-12">
      <Pagination 
        currentPage={page.currentPage} 
        totalPages={page.lastPage} 
        basePath={`/${collection}`} 
      />
    </div>
  </section>
</Mainlayout>