---
import { getCollection } from 'astro:content';
import Mainlayout from '../../layouts/Mainlayout.astro';
import Hero from '../../components/Hero.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';

export async function getStaticPaths({ paginate }) {
  const POSTS_PER_PAGE = 6;
  const [blogEntries, docsEntries, pluginsEntries, themesEntries] = await Promise.all([
    getCollection('blog'),
    getCollection('docs'),
    getCollection('plugins'),
    getCollection('themes'),
  ]);

  const entries = [...blogEntries, ...docsEntries, ...pluginsEntries, ...themesEntries].sort((a, b) => {
    const dateA = new Date(a.data.pubDate || Date.now()).valueOf();
    const dateB = new Date(b.data.pubDate || Date.now()).valueOf();
    return dateB - dateA;
  });

  return paginate(entries, {
    pageSize: POSTS_PER_PAGE,
  });
}

const { page } = Astro.props;
const title = `Trang ${page.currentPage} | Blog Chém Gió`;
---

<Mainlayout title={title}>
  <div class="w-full px-2 sm:px-4 md:px-8 lg:px-12 max-w-7xl mx-auto">
    <Hero />

    <main id="main-content">
      <div class="mt-2 mb-4 flex flex-col items-start">
        <h2 class="text-base md:text-lg font-black text-slate-900 dark:text-white flex items-center gap-3 uppercase tracking-tighter transition-colors duration-300">
          <span class="w-1.5 h-6 bg-[#ff7a18] rounded-full shadow-[0_0_10px_rgba(255,122,24,0.3)]"></span>
          Cập nhật mới nhất - Trang {page.currentPage}
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {page.data.map((post) => (
          <div class="post-wrapper">
            <PostCard
              {...post.data}
              slug={`/${post.collection}/${post.id}`}
              collection={post.collection}
            />
          </div>
        ))}
      </div>

      <Pagination currentPage={page.currentPage} totalPages={page.lastPage} basePath="/" />
    </main>
  </div>
</Mainlayout>

<style>
  #main-content {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .post-wrapper {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
</style>
