---
import Mainlayout from '../layouts/Mainlayout.astro';

const title = 'Liên hệ | Đường Tăng Review';
const site = Astro.site ?? new URL('https://duongtang.vn');
// Cập nhật link redirect sau khi gửi form thành công
const formNext = new URL('/lien-he?sent=1', site).href;
---

<Mainlayout title={title}>
  <section class="contact-page max-w-6xl mx-auto py-12 px-2 sm:px-4 md:px-6">
    <div class="mb-10">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 dark:text-white mb-3 tracking-tighter uppercase">
        Gieo duyên <span class="text-[#ff7a18]">hỏi đáp</span>
      </h1>
      <p class="text-slate-500 dark:text-slate-400 text-base md:text-lg italic">
        Thí chủ muốn thỉnh giáo về chuyện gì? Đừng ngần ngại gửi thư cho Đường Tăng.
      </p>
    </div>

    {Astro.url.searchParams.get('sent') === '1' && (
      <p
        class="mb-8 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-900 dark:border-emerald-800/60 dark:bg-emerald-950/40 dark:text-emerald-100"
        role="status"
      >
        Thiện tai! Tin nhắn đã được gửi đi. Đường Tăng sẽ sớm phản hồi thư cho thí chủ qua email.
      </p>
    )}

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-14 lg:items-start">
      <form
        class="contact-form space-y-4"
        action="https://formsubmit.co/truanhduc@gmail.com"
        method="POST"
      >
        <input type="hidden" name="_subject" value="[DuongTang.vn] Thư thỉnh giáo từ website" />
        <input type="hidden" name="_next" value={formNext} />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div>
          <label for="contact-name" class="mb-1 block text-xs font-black uppercase tracking-widest text-[#ff7a18]"
            >Pháp danh / Tên</label
          >
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            placeholder="Tên của thí chủ"
            class="w-full px-5 py-3.5 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-2xl focus:ring-2 focus:ring-[#ff7a18] outline-none transition-all text-slate-900 dark:text-white"
          />
        </div>
        <div>
          <label for="contact-email" class="mb-1 block text-xs font-black uppercase tracking-widest text-[#ff7a18]"
            >Địa chỉ Email</label
          >
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            placeholder="email@example.com"
            class="w-full px-5 py-3.5 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-2xl focus:ring-2 focus:ring-[#ff7a18] outline-none transition-all text-slate-900 dark:text-white"
          />
        </div>
        <div>
          <label for="contact-message" class="mb-1 block text-xs font-black uppercase tracking-widest text-[#ff7a18]"
            >Nội dung muốn nói</label
          >
          <textarea
            id="contact-message"
            name="message"
            required
            rows="5"
            placeholder="Nội dung tin nhắn thỉnh giáo..."
            class="w-full px-5 py-3.5 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-700 rounded-2xl focus:ring-2 focus:ring-[#ff7a18] outline-none transition-all resize-y min-h-[120px] text-slate-900 dark:text-white"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-2xl font-black uppercase tracking-widest text-xs hover:bg-[#ff7a18] dark:hover:bg-[#ff7a18] dark:hover:text-white transition-all shadow-lg"
        >
          Gửi thư thỉnh giáo
        </button>
        <p class="text-[11px] text-slate-500 dark:text-slate-500 leading-relaxed text-center">
          Nam mô A Di Đà Phật! <br/>
          Thư sẽ được chuyển thẳng đến <strong>truanhduc@gmail.com</strong>.
        </p>
      </form>

      <aside class="contact-aside space-y-8">
        <div class="p-6 bg-slate-50 dark:bg-slate-900/40 rounded-3xl border border-slate-100 dark:border-slate-800">
          <h3 class="text-xs font-black text-[#ff7a18] uppercase tracking-[0.2em] mb-4">Kênh liên lạc</h3>
          <div class="space-y-6">
            <div>
              <p class="text-xs font-bold text-slate-400 uppercase mb-1">Email cá nhân</p>
              <a href="mailto:truanhduc@gmail.com" class="text-slate-900 dark:text-white font-bold text-lg hover:text-[#ff7a18] transition-colors break-all">
                truanhduc@gmail.com
              </a>
            </div>
            
            <div>
              <p class="text-xs font-bold text-slate-400 uppercase mb-1">Trao đổi nhanh</p>
              <ul class="space-y-3">
                <li class="flex items-center gap-2">
                  <span class="font-bold text-slate-900 dark:text-white">Facebook:</span>
                  <a href="https://www.facebook.com/truanhduc" target="_blank" class="text-[#ff7a18] hover:underline font-semibold">truanhduc</a>
                </li>
                <li class="flex items-center gap-2">
                  <span class="font-bold text-slate-900 dark:text-white">Zalo:</span>
                  <a href="https://zalo.me/0339229998" class="text-[#ff7a18] hover:underline font-semibold">0339229998</a>
                </li>
              </ul>
            </div>
          </div>

          <div class="flex gap-3 pt-6">
            <a
              href="https://www.facebook.com/truanhduc"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 px-6 items-center justify-center rounded-xl bg-white dark:bg-slate-800 text-sm font-black text-slate-800 dark:text-white shadow-sm hover:bg-[#ff7a18] hover:text-white transition-all border border-slate-200 dark:border-slate-700"
              >Facebook</a
            >
            <a
              href="https://zalo.me/0339009998"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 px-6 items-center justify-center rounded-xl bg-white dark:bg-slate-800 text-sm font-black text-slate-800 dark:text-white shadow-sm hover:bg-[#ff7a18] hover:text-white transition-all border border-slate-200 dark:border-slate-700"
              >Zalo</a
            >
          </div>
        </div>

        <div class="text-center p-6 border-2 border-dashed border-slate-100 dark:border-slate-800 rounded-3xl group hover:border-[#ff7a18] transition-colors duration-300">
           <p class="text-sm italic text-slate-500">
             "Gặp nhau là cái duyên, <br/>
             Giúp được nhau là cái phúc<br/>
             Mua hàng ở đâu cũng thế, chi bằng mua hết ở 
             <a 
               href="https://shopee.vn" 
               target="_blank" 
               rel="noopener noreferrer" 
               class="text-[#ff7a18] font-bold underline decoration-dotted underline-offset-4 hover:decoration-solid transition-all"
             >
               Shopee
             </a>."
           </p>
        </div>
      </aside>
    </div>
  </section>
</Mainlayout>