---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DarkModeToggle from '../components/DarkModeToggle.astro';
import BackToTop from '../components/BackToTop.astro';
import ChatBot from '../components/ChatBot.astro';
// Lưu ý: Nếu bạn dùng inline CSS, có thể bỏ import file css bên ngoài nếu file đó quá nhỏ
import '../styles/global.css'; 

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article' | 'profile';
}

const {
  title = "Đường Tăng.vn",
  description = "Đường Tăng.vn chia sẻ kinh nghiệm thực chiến về săn deal Shopee, review công nghệ và hành trình thỉnh kinh tại Đông Lào.",
  canonical,
  ogImage = "/default-og.webp",
  type = 'website',
} = Astro.props;

const currentUrl = new URL(Astro.url.pathname, 'https://duongtang.vn').toString();
const canonicalUrl = canonical || currentUrl;

const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <rect width="64" height="64" rx="14" fill="#ee4d2d"/>
  <path d="M20 26c0-6.6 5.4-12 12-12s12 5.4 12 12" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round"/>
  <path d="M18 26h28c2.2 0 4 1.8 4 4l-2.2 21.9c-.2 2-1.9 3.6-3.9 3.6H20.1c-2 0-3.7-1.6-3.9-3.6L14 30c0-2.2 1.8-4 4-4z" fill="none" stroke="#fff" stroke-width="4" stroke-linejoin="round"/>
  <text x="32" y="46" text-anchor="middle" font-size="28" font-family="Arial, sans-serif" font-weight="900" fill="#ffffff">S</text>
</svg>`;
const faviconHref = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
---

<!doctype html>
<html lang="vi">
  <head>
    <link rel="icon" href={faviconHref}>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index,follow,max-image-preview:large" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Đường Tăng.vn" />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (function() {
        const STORAGE_KEY = 'darkMode';
        const CLASS_NAME = 'is-dark';
        const getInitialTheme = () => {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved !== null) return saved === 'enabled';
          return true; 
        };
        if (getInitialTheme()) {
          document.documentElement.classList.add(CLASS_NAME);
        } else {
          document.documentElement.classList.remove(CLASS_NAME);
        }
      })();
    </script>
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Đường Tăng.vn",
        "url": "https://duongtang.vn",
        "description": "Blog chia sẻ kinh nghiệm thực chiến về săn deal Shopee, review công nghệ và hành trình thỉnh kinh tại Đông Lào.",
        "inLanguage": "vi-VN",
      })}
    </script>
  </head>

  <body class="bg-slate-50 text-slate-900 dark:bg-[#020617] dark:text-slate-300 min-h-screen flex flex-col font-sans antialiased transition-colors duration-300 relative overflow-x-hidden">
    <Header />
    <div class="flex-grow w-full"> 
      <main class="w-full mt-2 mb-12">
        <article class="content-wrapper w-full max-w-none px-2 md:px-10 lg:px-16 ml-0 mr-0">
          <slot /> 
        </article>
      </main>
    </div>
    <Footer />
    <DarkModeToggle />
    <BackToTop />
    <ChatBot />
  </body>
</html>

<style is:inline is:global>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
    background-color: #020617;
  }

  html:not(.is-dark) {
    background-color: #f8fafc;
  }

  header ul, header li, nav ul, nav li {
    list-style: none !important;
    margin: 0;
    padding: 0;
  }

  .content-wrapper {
    width: 100% !important;
    max-width: none !important;
    word-wrap: break-word;
    font-size: 14px !important; 
    line-height: 1.6 !important;
    color: #475569;
    margin: 0 !important;
    text-align: left;
  }

  .is-dark .content-wrapper { color: #94a3b8 !important; }
  .content-wrapper > * { width: 100% !important; }

  h1 {
    font-size: 1.5rem !important; 
    font-weight: 800 !important;
    margin-bottom: 1rem !important;
    line-height: 1.2 !important;
    letter-spacing: -0.02em !important;
    color: #1e293b !important;
  }
  .is-dark h1 { color: #f8fafc !important; }

  h2 {
    font-size: 1.125rem !important; 
    font-weight: 700 !important;
    margin-top: 1.5rem !important;
    margin-bottom: 0.75rem !important;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 0.3rem;
    color: #334155 !important;
  }
  .is-dark h2 { color: #f1f5f9 !important; border-bottom-color: #1e293b !important; }

  h3 { font-size: 0.9375rem !important; font-weight: 700 !important; }
  p { margin-bottom: 1rem !important; }

  .content-wrapper img { 
    border-radius: 8px; 
    width: 100% !important;
    height: auto;
    margin: 1.5rem 0;
  }

  @media (max-width: 768px) {
    .content-wrapper { font-size: 13px !important; padding-left: 0.5rem !important; padding-right: 0.5rem !important; }
    h1 { font-size: 1.35rem !important; }
    h2 { font-size: 1.05rem !important; }
  }
</style>
